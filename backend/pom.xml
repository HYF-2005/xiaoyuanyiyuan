<?xml version="1.0" encoding="UTF-8"?>
<!-- Maven 构建配置：管理 Java 版本、第三方依赖和打包插件，不是接口运行代码。 -->
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
<modelVersion>4.0.0</modelVersion>
<!-- 继承 Spring Boot 3.3.12 的依赖版本与构建默认配置。 -->
<parent>
  <groupId>org.springframework.boot</groupId>
  <artifactId>spring-boot-starter-parent</artifactId>
  <version>3.3.12</version>
  <relativePath/>
</parent>
<groupId>com.campushelp</groupId>
<artifactId>campus-help-backend</artifactId>
<version>1.0.0-SNAPSHOT</version>
<name>campus-help-backend</name>
<!-- Spring Boot 3 需要 Java 17；这里决定编译目标，系统运行也必须提供合适 JDK。 -->
<properties><java.version>17</java.version></properties>
<dependencies>
  <!-- Spring MVC + 内置 Tomcat + JSON，提供 HTTP Controller 服务。 -->
  <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-web</artifactId></dependency>
  <!-- 提供参数校验工具；引入依赖不等于每个参数都自动验证。 -->
  <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-validation</artifactId></dependency>
  <!-- 把 Mapper 接口及 SQL 接入 Spring 数据源，负责数据库访问。 -->
  <dependency><groupId>org.mybatis.spring.boot</groupId><artifactId>mybatis-spring-boot-starter</artifactId><version>3.0.4</version></dependency>
  <!-- MySQL JDBC 驱动，runtime 表示运行时使用。 -->
  <dependency><groupId>com.mysql</groupId><artifactId>mysql-connector-j</artifactId><scope>runtime</scope></dependency>
  <!-- 仅使用加密工具（BCrypt），本项目鉴权由自己的拦截器完成。 -->
  <dependency><groupId>org.springframework.security</groupId><artifactId>spring-security-crypto</artifactId></dependency>
  <!-- 编译期生成 @Data 字段访问方法，减少样板代码。 -->
  <dependency><groupId>org.projectlombok</groupId><artifactId>lombok</artifactId><optional>true</optional></dependency>
  <!-- JUnit/Mockito 测试依赖，仅测试阶段使用。 -->
  <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-test</artifactId><scope>test</scope></dependency>
</dependencies>
<!-- Spring Boot 插件把代码与依赖打成可用 java -jar 启动的 JAR。 -->
<build><plugins><plugin><groupId>org.springframework.boot</groupId><artifactId>spring-boot-maven-plugin</artifactId></plugin></plugins></build>
</project>
