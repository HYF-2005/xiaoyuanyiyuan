/* 公告中心：筛选栏、公告卡片、未读红点和空状态。 */

page {
  background: #f5f5f5;
}

.notice-center {
  min-height: 100vh;
  padding-bottom: 60rpx;
}

.notice-filter {
  position: sticky;
  top: 0;
  z-index: 5;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 28rpx 16rpx;
  background: #fff;
}

.filter-chips {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.filter-chip {
  display: flex;
  align-items: center;
  gap: 6rpx;
  height: 56rpx;
  padding: 0 22rpx;
  border-radius: 28rpx;
  background: #f4f5f6;
  color: #6b747e;
  font-size: 23rpx;
}

.filter-chip.active {
  background: #e8faf0;
  color: #08a052;
  font-weight: 600;
}

.chip-count {
  box-sizing: border-box;
  min-width: 26rpx;
  height: 26rpx;
  padding: 0 6rpx;
  border-radius: 13rpx;
  background: #fa5151;
  color: #fff;
  font-size: 17rpx;
  line-height: 26rpx;
  text-align: center;
}

.read-all {
  padding: 10rpx 0 10rpx 12rpx;
  color: #0a8f4b;
  font-size: 22rpx;
}

.read-all.disabled {
  color: #c2c7cc;
}

.notice-summary {
  padding: 2rpx 30rpx 10rpx;
  background: #fff;
  color: #a3aab3;
  font-size: 21rpx;
}

.notice-list {
  padding: 20rpx 28rpx 40rpx;
}

.notice-card {
  margin-bottom: 18rpx;
  padding: 26rpx 26rpx 22rpx;
  border-radius: 24rpx;
  background: #fff;
  box-shadow: 0 2rpx 10rpx rgba(16, 24, 40, 0.025);
}

.notice-card-top {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
}

.notice-title-row {
  display: flex;
  flex: 1;
  align-items: flex-start;
  min-width: 0;
}

.notice-dot {
  flex: none;
  width: 12rpx;
  height: 12rpx;
  margin: 12rpx 12rpx 0 0;
  border-radius: 50%;
  background: #fa5151;
}

.notice-dot.is-read {
  background: transparent;
}

.notice-title {
  flex: 1;
  min-width: 0;
  color: #1b2127;
  font-size: 28rpx;
  font-weight: 600;
  line-height: 1.45;
}

.notice-card.is-read .notice-title {
  color: #6b747e;
  font-weight: 500;
}

.notice-arrow {
  flex: none;
  width: 10rpx;
  height: 10rpx;
  margin: 14rpx 2rpx 0 16rpx;
  border-top: 2rpx solid #c4c9ce;
  border-right: 2rpx solid #c4c9ce;
  transform: rotate(45deg);
}

.notice-summary-text {
  display: -webkit-box;
  margin-top: 12rpx;
  overflow: hidden;
  color: #8b949e;
  font-size: 22rpx;
  line-height: 1.65;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.notice-card.is-read .notice-summary-text {
  color: #aab1b9;
}

.notice-card-bottom {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 18rpx;
}

.notice-tags {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 8rpx;
}

.notice-tag {
  padding: 4rpx 10rpx;
  border-radius: 6rpx;
  font-size: 18rpx;
  line-height: 1.4;
}

.tag-system {
  background: #eef7f1;
  color: #0a8f4b;
}

.tag-activity {
  background: #fff5e8;
  color: #d97706;
}

.tag-level {
  background: #fff0f0;
  color: #e5484d;
}

.tag-pin {
  background: #eef2f8;
  color: #4b5563;
}

.notice-time {
  flex: none;
  margin-left: 12rpx;
  color: #aab1b9;
  font-size: 20rpx;
}

.notice-list-end {
  padding: 20rpx 0 0;
  color: #c0c5cb;
  font-size: 20rpx;
  text-align: center;
}

.notice-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 70vh;
  padding: 0 40rpx;
}

.notice-empty-icon {
  width: 96rpx;
  height: 96rpx;
  opacity: 0.22;
}

.notice-empty-title {
  margin-top: 22rpx;
  color: #7e8791;
  font-size: 27rpx;
}

.notice-empty-sub {
  margin-top: 10rpx;
  color: #b0b6bd;
  font-size: 22rpx;
}

.notice-loading {
  padding: 140rpx 0;
  color: #aab1b9;
  font-size: 24rpx;
  text-align: center;
}
