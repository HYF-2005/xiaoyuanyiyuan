/* 登录：账号密码登录、手机号演示验证码登录和登录方式切换：本文件控制页面外观，不发请求、不改数据库。 */
page {
  background: #655cba; /* 背景：#655cba */
}

.login-page {
  min-height: 100vh; /* 最小高度，内容多时可以增高：100vh */
  box-sizing: border-box; /* 设置的宽高包含内边距和边框 */
  padding: 150rpx 56rpx 40rpx; /* 内边距：内容到边框之间的间距；此处按 上、左右、下 设置为 150rpx 56rpx 40rpx。 */
  color: #fff; /* 文字颜色：#fff */
}

.brand {
  display: flex; /* 启用弹性布局，排列内部元素 */
  flex-direction: column; /* 主轴改为竖直方向，子元素上下排列 */
  align-items: center; /* 子元素沿交叉轴居中 */
}

.brand-logo {
  width: 160rpx; /* 宽度：160rpx */
  height: 155rpx; /* 高度：155rpx */
  display: block; /* 设置为块级显示 */
}

.brand-name {
  margin-top: 18rpx; /* 上外边距：18rpx */
  font-size: 36rpx; /* 字号：36rpx */
  font-weight: bold; /* 文字加粗 */
}

.login-tabs {
  display: flex; /* 启用弹性布局，排列内部元素 */
  height: 78rpx; /* 高度：78rpx */
  margin-top: 68rpx; /* 上外边距：68rpx */
  padding: 6rpx; /* 内边距：内容到边框之间的间距；此处按 四边 设置为 6rpx。 */
  border-radius: 12rpx; /* 设置圆角为 12rpx；一个值应用四角，四个值依次为左上、右上、右下、左下；50% 在正方形上得到圆形。 */
  background: rgba(255, 255, 255, 0.16); /* 背景：rgba(255, 255, 255, 0.16) */
}

.tab {
  flex: 1; /* 按权重 1 分配剩余空间，并允许压缩 */
  display: flex; /* 启用弹性布局，排列内部元素 */
  align-items: center; /* 子元素沿交叉轴居中 */
  justify-content: center; /* 子元素沿主轴居中 */
  font-size: 27rpx; /* 字号：27rpx */
}

.tab.active {
  color: #655cba; /* 文字颜色：#655cba */
  background: #fff; /* 背景：#fff */
  border-radius: 9rpx; /* 设置圆角为 9rpx；一个值应用四角，四个值依次为左上、右上、右下、左下；50% 在正方形上得到圆形。 */
}

.login-card {
  margin-top: 38rpx; /* 上外边距：38rpx */
  padding: 32rpx; /* 内边距：内容到边框之间的间距；此处按 四边 设置为 32rpx。 */
  border-radius: 18rpx; /* 设置圆角为 18rpx；一个值应用四角，四个值依次为左上、右上、右下、左下；50% 在正方形上得到圆形。 */
  background: #fff; /* 背景：#fff */
  color: #333; /* 文字颜色：#333 */
}

.field-label {
  display: flex; /* 启用弹性布局，排列内部元素 */
  align-items: center; /* 子元素沿交叉轴居中 */
  margin: 16rpx 0 12rpx; /* 外边距：元素外侧的间距；此处按 上、左右、下 设置为 16rpx 0 12rpx。 */
  font-size: 26rpx; /* 字号：26rpx */
}

.field-label-icon {
  width: 28rpx; /* 宽度：28rpx */
  height: 28rpx; /* 高度：28rpx */
  margin-right: 10rpx; /* 右外边距：10rpx */
  flex: none; /* 不伸长，也不压缩 */
}

.field-label .hint {
  margin-left: 12rpx; /* 左外边距：12rpx */
}

.field-box,
.password-box {
  height: 78rpx; /* 高度：78rpx */
  box-sizing: border-box; /* 设置的宽高包含内边距和边框 */
  padding: 0 18rpx; /* 内边距：内容到边框之间的间距；此处按 上下、左右 设置为 0 18rpx。 */
  border-radius: 8rpx; /* 设置圆角为 8rpx；一个值应用四角，四个值依次为左上、右上、右下、左下；50% 在正方形上得到圆形。 */
  background: #f6f6f6; /* 背景：#f6f6f6 */
  font-size: 26rpx; /* 字号：26rpx */
}

.field-box {
  display: flex; /* 启用弹性布局，排列内部元素 */
  align-items: center; /* 子元素沿交叉轴居中 */
}

.school,
.password-box {
  display: flex; /* 启用弹性布局，排列内部元素 */
  align-items: center; /* 子元素沿交叉轴居中 */
  justify-content: space-between; /* 两端贴边，中间空隙均分 */
}

.arrow {
  color: #999; /* 文字颜色：#999 */
}

.password-box input {
  flex: 1; /* 按权重 1 分配剩余空间，并允许压缩 */
  min-width: 0; /* 允许子元素缩小，避免长内容撑宽布局 */
}

.forgot {
  margin: 18rpx 0; /* 外边距：元素外侧的间距；此处按 上下、左右 设置为 18rpx 0。 */
  text-align: right; /* 文字右对齐 */
  color: #655cba; /* 文字颜色：#655cba */
  font-size: 23rpx; /* 字号：23rpx */
  text-decoration: underline; /* 文字添加下划线 */
}

.login-button {
  width: 100%; /* 宽度：100% */
  height: 78rpx; /* 高度：78rpx */
  box-sizing: border-box; /* 设置的宽高包含内边距和边框 */
  display: flex; /* 启用弹性布局，排列内部元素 */
  align-items: center; /* 子元素沿交叉轴居中 */
  justify-content: center; /* 子元素沿主轴居中 */
  border-radius: 8rpx; /* 设置圆角为 8rpx；一个值应用四角，四个值依次为左上、右上、右下、左下；50% 在正方形上得到圆形。 */
  background: #655cba; /* 背景：#655cba */
  color: #fff; /* 文字颜色：#fff */
  font-size: 28rpx; /* 字号：28rpx */
  font-weight: bold; /* 文字加粗 */
}

.agreement {
  display: flex; /* 启用弹性布局，排列内部元素 */
  align-items: center; /* 子元素沿交叉轴居中 */
  margin: 58rpx 12rpx 0; /* 外边距：元素外侧的间距；此处按 上、左右、下 设置为 58rpx 12rpx 0。 */
  font-size: 22rpx; /* 字号：22rpx */
}

.policy-link {
  color: #fff; /* 协议链接放在紫色背景上，使用白色保证清晰可见 */
  text-decoration: underline; /* 保留链接视觉提示 */
}

.check-box {
  width: 32rpx; /* 宽度：32rpx */
  height: 32rpx; /* 高度：32rpx */
  margin-right: 14rpx; /* 右外边距：14rpx */
  background: #fff; /* 背景：#fff */
  border-radius: 4rpx; /* 设置圆角为 4rpx；一个值应用四角，四个值依次为左上、右上、右下、左下；50% 在正方形上得到圆形。 */
}

.hint {
  color: #999; /* 文字颜色：#999 */
  font-size: 22rpx; /* 字号：22rpx */
}

.code-row {
  display: flex; /* 启用弹性布局，排列内部元素 */
  gap: 16rpx; /* 子元素之间的间隔：16rpx */
  margin-bottom: 28rpx; /* 下外边距：28rpx */
}

.code-input {
  flex: 1; /* 按权重 1 分配剩余空间，并允许压缩 */
  min-width: 0; /* 允许子元素缩小，避免长内容撑宽布局 */
}

.code-button {
  width: 160rpx; /* 宽度：160rpx */
  flex-shrink: 0; /* 空间不足时不压缩 */
  display: flex; /* 启用弹性布局，排列内部元素 */
  align-items: center; /* 子元素沿交叉轴居中 */
  justify-content: center; /* 子元素沿主轴居中 */
  border-radius: 8rpx; /* 设置圆角为 8rpx；一个值应用四角，四个值依次为左上、右上、右下、左下；50% 在正方形上得到圆形。 */
  background: #655cba; /* 背景：#655cba */
  color: #fff; /* 文字颜色：#fff */
  font-size: 22rpx; /* 字号：22rpx */
}

.check-box {
  width: 32rpx; /* 宽度：32rpx */
  height: 32rpx; /* 高度：32rpx */
  margin-right: 14rpx; /* 右外边距：14rpx */
  background: #fff; /* 背景：#fff */
  border-radius: 4rpx; /* 设置圆角为 4rpx；一个值应用四角，四个值依次为左上、右上、右下、左下；50% 在正方形上得到圆形。 */
  display: flex; /* 启用弹性布局，排列内部元素 */
  align-items: center; /* 子元素沿交叉轴居中 */
  justify-content: center; /* 子元素沿主轴居中 */
  color: #655cba; /* 文字颜色：#655cba */
}

.check-box.checked {
  background: #fff; /* 背景：#fff */
}

.register-link {
  margin-top: 24rpx; /* 上外边距：24rpx */
  text-align: center; /* 文字水平居中 */
  color: #655cba; /* 文字颜色：#655cba */
  font-size: 26rpx; /* 字号：26rpx */
}
