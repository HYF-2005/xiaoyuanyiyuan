<!-- 忘记密码：身份验证界面与设置新密码；最终校验由后端完成；WXML 描述页面结构，不是浏览器 HTML。 -->
<!-- 界面区块 forgot-page：忘记密码 / 页面，外观由同页 WXSS 的同名类控制。 -->
<view class="forgot-page">
  <!-- 界面区块 steps：步骤，外观由同页 WXSS 的同名类控制。 -->
  <view class="steps">
    <view class="step current">
      <view class="step-number">1</view>
      <text>身份验证</text>
    </view>
    <view class="step-line {{step === 2 ? 'completed' : ''}}"></view>
    <view class="step {{step === 2 ? 'current' : ''}}">
      <view class="step-number">2</view>
      <text>设置新密码</text>
    </view>
  </view>

  <!-- 界面区块 verify-card：verify / 卡片，外观由同页 WXSS 的同名类控制。 -->
  <!-- wx:if 条件 step === 1 成立才创建此区块；隐藏按钮不等于后端授权。 -->
  <view class="verify-card" wx:if="{{step === 1}}">
    <view class="card-title">身份验证</view>
    <view class="card-tip">请输入学号和已绑定的手机号进行身份验证</view>

    <view class="field-label">学号</view>
    <!-- 输入变化调用 onStudentIdInput()，函数在同页 JS；data-* 携带所点项目的信息。 -->
    <input class="field-input" placeholder="请输入学号" bindinput="onStudentIdInput" />

    <view class="field-label">手机号</view>
    <input class="field-input" type="number" maxlength="11"
    placeholder="请输入手机号" bindinput="onPhoneInput" />

    <view class="field-label">验证码</view>
    <view class="code-row">
      <input class="field-input code-input" type="number"
      placeholder="请输入验证码" bindinput="onCodeInput" />
      <view class="code-button" bindtap="getDemoCode">获取验证码</view>
    </view>

    <view class="next-button" bindtap="nextStep">下一步</view>
  </view>
  <view class="verify-card" wx:else>
    <view class="card-title">设置新密码</view>
    <!-- 界面区块 card-tip：卡片 / tip，外观由同页 WXSS 的同名类控制。 -->
    <view class="card-tip">请输入新密码（8–10位，包含字母和数字）</view>
    <view class="field-label">新密码</view>
    <!-- 界面区块 password-row：密码 / 一行内容，外观由同页 WXSS 的同名类控制。 -->
    <view class="password-row">
      <input password="{{hideNewPassword}}"
      value="{{newPassword}}"
      placeholder="请输入新密码"
      bindinput="onNewPasswordInput" />
      <!-- 点击调用 toggleNewPassword()，函数在同页 JS；data-* 携带所点项目的信息。 -->
      <view
        class="visibility-toggle"
        role="button"
        aria-label="{{hideNewPassword ? '显示新密码' : '隐藏新密码'}}"
        bindtap="toggleNewPassword"
      >
        <view class="visibility-eye {{hideNewPassword ? 'closed' : ''}}"></view>
      </view>
    </view>
    <!-- 界面区块 strength-row：密码强度 / 一行内容，外观由同页 WXSS 的同名类控制。 -->
    <!-- wx:if 条件 newPassword 成立才创建此区块；隐藏按钮不等于后端授权。 -->
    <view class="strength-row" wx:if="{{newPassword}}">
      <text>密码强度</text>
      <!-- 界面区块 strength-bars：密码强度 / bars，外观由同页 WXSS 的同名类控制。 -->
      <view class="strength-bars">
        <view class="strength-bar"
        style="background: {{strengthColor}};"></view>
      <view class="strength-bar"
      style="background: {{passwordStrength >= 2 ? strengthColor : '#eee'}};"></view>
    <view class="strength-bar"
    style="background: {{passwordStrength >= 3 ? strengthColor : '#eee'}};"></view>
</view>
<text style="color: {{strengthColor}};">{{strengthLabel}}</text>
</view>
<view class="field-label">确认密码</view>
<view class="password-row">
  <input password="{{hideConfirmPassword}}"
  value="{{confirmPassword}}"
  placeholder="请再次输入新密码"
  bindinput="onConfirmPasswordInput" />
  <!-- 点击调用 toggleConfirmPassword()，函数在同页 JS；data-* 携带所点项目的信息。 -->
  <view
    class="visibility-toggle"
    role="button"
    aria-label="{{hideConfirmPassword ? '显示确认密码' : '隐藏确认密码'}}"
    bindtap="toggleConfirmPassword"
  >
    <view class="visibility-eye {{hideConfirmPassword ? 'closed' : ''}}"></view>
  </view>
</view>


<!-- 界面区块 next-button：next / 按钮，外观由同页 WXSS 的同名类控制。 -->
<!-- 点击调用 confirmReset()，函数在同页 JS；data-* 携带所点项目的信息。 -->
<view class="next-button" bindtap="confirmReset">确认重置</view>
</view>
</view>
