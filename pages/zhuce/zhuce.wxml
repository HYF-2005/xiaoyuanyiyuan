<!-- 实名认证注册：手机验证 → 身份信息 → 本人照片 → 确认提交；WXML 只描述结构。 -->
<view class="auth-page">
  <!-- 顶部三步进度 -->
  <view class="steps-card">
    <view class="step {{step > 1 ? 'done' : ''}} {{step === 1 ? 'active' : ''}}">
      <view class="step-dot">{{step > 1 ? '✓' : '1'}}</view>
      <text class="step-label">手机验证</text>
    </view>
    <view class="step-line {{step > 1 ? 'completed' : ''}}"></view>
    <view class="step {{step > 2 ? 'done' : ''}} {{step === 2 ? 'active' : ''}}">
      <view class="step-dot">{{step > 2 ? '✓' : '2'}}</view>
      <text class="step-label">身份识别</text>
    </view>
    <view class="step-line {{step > 2 ? 'completed' : ''}}"></view>
    <view class="step {{step === 3 ? 'active' : ''}}">
      <view class="step-dot">3</view>
      <text class="step-label">确认提交</text>
    </view>
  </view>

  <view class="auth-card">
    <!-- 步骤一：手机号验证 -->
    <block wx:if="{{stage === 'phone'}}">
      <view class="card-title">验证手机号</view>
      <view class="card-subtitle">请输入本人手机号进行验证</view>

      <view class="field-label">手机号</view>
      <input
        class="field-input"
        type="number"
        maxlength="11"
        value="{{phone}}"
        placeholder="请输入本人手机号"
        placeholder-class="input-placeholder"
        bindinput="onPhoneInput"
      />

      <view class="field-label">验证码</view>
      <view class="code-row">
        <input
          class="field-input code-input"
          type="number"
          maxlength="6"
          value="{{code}}"
          placeholder="请输入6位验证码"
          placeholder-class="input-placeholder"
          bindinput="onFieldInput"
          data-field="code"
        />
        <view class="code-button {{countdown > 0 ? 'disabled' : ''}}" bindtap="sendCode">
          {{countdown > 0 ? countdown + 's 后重发' : '发送验证码'}}
        </view>
      </view>
      <view wx:if="{{codePhone}}" class="code-tip">验证码已发送至 {{codePhone}}</view>

      <view class="agreement" bindtap="toggleAgreement">
        <view class="checkbox {{agreed ? 'checked' : ''}}">{{agreed ? '✓' : ''}}</view>
        <view class="agreement-copy">
          我已阅读并同意
          <text class="policy-link" data-type="agreement" catchtap="openPolicy">《用户协议》</text>
          和
          <text class="policy-link" data-type="privacy" catchtap="openPolicy">《隐私政策》</text>
        </view>
      </view>

      <button class="primary-button {{canNextPhone ? '' : 'is-disabled'}}" bindtap="nextPhone">下一步</button>
    </block>

    <!-- 手机号验证后设置登录密码 -->
    <block wx:elif="{{stage === 'password'}}">
      <view class="card-title">设置密码</view>
      <view class="card-subtitle">为了账户安全，请设置登录密码</view>

      <view class="field-label">新密码</view>
      <view class="password-field">
        <input
          class="field-input"
          password="{{!showPassword}}"
          maxlength="10"
          value="{{newPassword}}"
          placeholder="8-10位，包含数字和字母"
          placeholder-class="input-placeholder"
          bindinput="onFieldInput"
          data-field="newPassword"
        />
        <view class="visibility-toggle" bindtap="togglePassword" data-field="showPassword">
          <view class="visibility-eye {{showPassword ? '' : 'closed'}}"></view>
        </view>
      </view>
      <view class="field-hint">密码需为 8–10 位，并同时包含数字和字母</view>

      <view class="field-label">确认密码</view>
      <view class="password-field">
        <input
          class="field-input"
          password="{{!showConfirmPassword}}"
          maxlength="10"
          value="{{confirmPassword}}"
          placeholder="请再次输入新密码"
          placeholder-class="input-placeholder"
          bindinput="onFieldInput"
          data-field="confirmPassword"
        />
        <view class="visibility-toggle" bindtap="togglePassword" data-field="showConfirmPassword">
          <view class="visibility-eye {{showConfirmPassword ? '' : 'closed'}}"></view>
        </view>
      </view>

      <view class="button-row">
        <button class="secondary-button" bindtap="backToPhone">上一步</button>
        <button class="primary-button {{canNextPassword ? '' : 'is-disabled'}}" bindtap="nextPassword">下一步</button>
      </view>
    </block>

    <!-- 步骤二：身份证人像面和身份信息 -->
    <block wx:elif="{{stage === 'id'}}">
      <view class="card-title">拍摄身份证</view>
      <view class="card-subtitle">为共同守护校园安全，平台对所有用户实行实名认证</view>
      <view class="card-subtitle compact">您上传的身份证信息仅用于身份核验</view>

      <view class="field-label">身份证人像面 <text class="required">*</text></view>
      <view class="upload-box id-upload" bindtap="chooseIdPhoto">
        <image wx:if="{{idPhoto}}" class="uploaded-image" src="{{idPhoto}}" mode="aspectFill"></image>
        <view wx:else class="id-placeholder">
          <view class="id-illustration">
            <view class="id-avatar"></view>
            <view class="id-lines">
              <view></view>
              <view></view>
              <view></view>
              <view></view>
            </view>
          </view>
          <view class="upload-main">点击拍摄身份证人像面</view>
          <view class="upload-desc">包含姓名、身份证号等信息</view>
        </view>
        <view wx:if="{{idPhoto}}" class="replace-tip">点击重新拍摄</view>
      </view>

      <view wx:if="{{idPhoto}}" class="identity-panel">
        <view class="panel-heading">身份信息</view>
        <view class="panel-hint">请核对身份证信息，性别和出生日期将自动识别</view>

        <view class="field-label">姓名 <text class="required">*</text></view>
        <input
          class="field-input"
          value="{{realName}}"
          maxlength="64"
          placeholder="请输入身份证上的姓名"
          placeholder-class="input-placeholder"
          bindinput="onFieldInput"
          data-field="realName"
        />

        <view class="field-label">身份证号 <text class="required">*</text></view>
        <input
          class="field-input"
          type="idcard"
          maxlength="18"
          value="{{idCard}}"
          placeholder="请输入18位身份证号码"
          placeholder-class="input-placeholder"
          bindinput="onIdInput"
        />

        <view class="identity-grid">
          <view>
            <text class="small-label">性别</text>
            <text class="identity-value">{{gender || '填写身份证号后自动获取'}}</text>
          </view>
          <view>
            <text class="small-label">出生日期</text>
            <text class="identity-value">{{birthDate || '填写身份证号后自动获取'}}</text>
          </view>
        </view>
      </view>

      <view class="button-row">
        <button class="secondary-button" bindtap="backToPassword">上一步</button>
        <button class="primary-button {{canNextId ? '' : 'is-disabled'}}" bindtap="nextId">下一步</button>
      </view>
    </block>

    <!-- 步骤三：本人照片 -->
    <block wx:elif="{{stage === 'selfie'}}">
      <view class="card-title">上传本人照片</view>
      <view class="legal-copy">应运营商要求，根据《网络安全法》、《反电信网络诈骗法》等法律法规的要求，需上传照片进行信息登记</view>
      <view class="legal-copy">您上传的照片仅用于隐私号码报备认证</view>

      <view class="field-label">本人照片 <text class="required">*</text></view>
      <view class="upload-box selfie-upload" bindtap="chooseSelfie">
        <image wx:if="{{selfie}}" class="uploaded-image" src="{{selfie}}" mode="aspectFill"></image>
        <view wx:else class="selfie-placeholder">
          <view class="selfie-avatar">
            <image class="selfie-icon" src="/assets/icons/user.png" mode="aspectFit" />
          </view>
          <view class="upload-main">点击拍摄或选择本人照片</view>
          <view class="upload-desc">半身或证件照，头像清晰可见</view>
        </view>
        <view wx:if="{{selfie}}" class="replace-tip">点击重新拍摄</view>
      </view>

      <view wx:if="{{selfie}}" class="size-check">
        照片大小：<text class="size-value">{{selfieSizeText}}</text>
        <text class="size-ok"> ✓ 符合要求</text>
      </view>

      <view class="photo-tips">
        <view>· 请确保本人正面清晰可见</view>
        <view>· 光线充足，避免过度曝光或阴影</view>
        <view>· 照片仅用于运营商身份验证，不会泄露</view>
      </view>

      <view class="button-row">
        <button class="secondary-button" bindtap="backToId">上一步</button>
        <button class="primary-button {{canNextSelfie ? '' : 'is-disabled'}}" bindtap="nextSelfie">下一步</button>
      </view>
    </block>

    <!-- 步骤三：确认提交 -->
    <block wx:else>
      <view class="card-title">确认信息</view>

      <view class="confirm-card">
        <view class="confirm-title">身份信息</view>
        <view class="confirm-row">
          <text>姓名</text>
          <text>{{realName}}</text>
        </view>
        <view class="confirm-row">
          <text>身份证号</text>
          <text>{{idCard}}</text>
        </view>
        <view class="confirm-row">
          <text>性别</text>
          <text>{{gender || '—'}}</text>
        </view>
        <view class="confirm-row">
          <text>出生日期</text>
          <text>{{birthDate || '—'}}</text>
        </view>
      </view>

      <view class="confirm-card contact-card">
        <view class="confirm-title">联系方式</view>
        <view class="confirm-row">
          <text>手机号</text>
          <text>{{phone}}</text>
        </view>
      </view>

      <view class="privacy-note">实名信息仅用于一次性平台认证，不会对外公开</view>

      <view class="button-row">
        <button class="secondary-button" bindtap="backToSelfie">上一步</button>
        <button class="primary-button {{canSubmit && !submitting ? '' : 'is-disabled'}}" bindtap="submit">
          {{submitting ? '提交中…' : '提交认证'}}
        </button>
      </view>
    </block>
  </view>
</view>
