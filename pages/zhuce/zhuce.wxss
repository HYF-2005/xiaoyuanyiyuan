/* 实名认证注册：绿色底、白色步骤卡和表单卡，按 手机验证 → 身份识别 → 确认提交 分区。 */
page {
  background: #08b96e;
}

.auth-page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 24rpx 24rpx 56rpx;
  background: #08b96e;
}

/* 顶部三步进度 */
.steps-card {
  display: flex;
  align-items: flex-start;
  box-sizing: border-box;
  padding: 34rpx 24rpx 30rpx;
  border-radius: 24rpx;
  background: #fff;
}

.step {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  min-width: 0;
}

.step-dot {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: #eceff3;
  color: #9aa3ad;
  font-size: 28rpx;
  font-weight: 600;
  box-sizing: border-box;
}

.step.active .step-dot,
.step.done .step-dot {
  background: #08b96e;
  color: #fff;
}

.step.active .step-dot {
  box-shadow: 0 8rpx 18rpx rgba(8, 185, 110, 0.24);
}

.step-label {
  margin-top: 14rpx;
  color: #9aa3ad;
  font-size: 24rpx;
  line-height: 1.3;
  white-space: nowrap;
}

.step.active .step-label,
.step.done .step-label {
  color: #08b96e;
  font-weight: 600;
}

.step-line {
  flex: 0 0 70rpx;
  height: 2rpx;
  margin-top: 31rpx;
  background: #e5e9ee;
}

.step-line.completed {
  background: #08b96e;
}

/* 主卡片 */
.auth-card {
  box-sizing: border-box;
  margin-top: 24rpx;
  padding: 54rpx 40rpx 46rpx;
  border-radius: 24rpx;
  background: #fff;
}

.card-title {
  color: #1f2937;
  font-size: 44rpx;
  font-weight: 700;
  line-height: 1.35;
  text-align: center;
}

.card-subtitle {
  margin: 18rpx 0 0;
  color: #9aa3ad;
  font-size: 26rpx;
  line-height: 1.75;
  text-align: center;
}

.card-subtitle.compact {
  margin-top: 6rpx;
}

.legal-copy {
  margin: 12rpx 0 0;
  color: #9aa3ad;
  font-size: 24rpx;
  line-height: 1.8;
  text-align: center;
}

.legal-copy:first-of-type {
  margin-top: 22rpx;
}

.field-label {
  margin: 32rpx 0 14rpx;
  color: #24292f;
  font-size: 29rpx;
  line-height: 1.4;
}

.required {
  color: #f15050;
}

.field-input {
  box-sizing: border-box;
  width: 100%;
  height: 94rpx;
  padding: 0 24rpx;
  border: 0;
  border-radius: 10rpx;
  background: #f5f6f8;
  color: #1f2937;
  font-size: 30rpx;
}

.input-placeholder {
  color: #b0b6bf;
}

.field-hint {
  margin-top: 10rpx;
  color: #9aa3ad;
  font-size: 22rpx;
  line-height: 1.5;
}

.password-field {
  display: flex;
  align-items: center;
  box-sizing: border-box;
  overflow: hidden;
  border-radius: 10rpx;
  background: #f5f6f8;
}

.password-field .field-input {
  flex: 1;
  min-width: 0;
  width: auto;
  background: transparent;
}

.password-field .visibility-toggle {
  flex: 0 0 76rpx;
}

/* 验证码行 */
.code-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.code-input {
  flex: 1;
  min-width: 0;
}

.code-button {
  flex: 0 0 246rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  height: 94rpx;
  border-radius: 10rpx;
  background: #08b96e;
  color: #fff;
  font-size: 27rpx;
  font-weight: 500;
}

.code-button.disabled {
  background: #a7e2c8;
}

.code-tip {
  margin-top: 10rpx;
  color: #08a862;
  font-size: 22rpx;
}

/* 协议 */
.agreement {
  display: flex;
  align-items: flex-start;
  margin: 30rpx 0 4rpx;
  color: #7b8490;
  font-size: 23rpx;
  line-height: 1.65;
}

.checkbox {
  flex: 0 0 30rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  width: 30rpx;
  height: 30rpx;
  margin: 2rpx 12rpx 0 0;
  border: 2rpx solid #cfd6df;
  border-radius: 6rpx;
  color: #fff;
  font-size: 22rpx;
  line-height: 1;
}

.checkbox.checked {
  border-color: #08b96e;
  background: #08b96e;
}

.agreement-copy {
  flex: 1;
  min-width: 0;
}

.policy-link {
  color: #08b96e;
}

/* 按钮 */
.primary-button,
.secondary-button {
  box-sizing: border-box;
  width: 100% !important;
  height: 94rpx;
  margin: 0;
  padding: 0;
  border: 0;
  border-radius: 12rpx;
  color: #fff;
  font-size: 31rpx;
  font-weight: 600;
  line-height: 94rpx;
  text-align: center;
}

.primary-button::after,
.secondary-button::after {
  border: 0;
}

.primary-button {
  margin-top: 30rpx;
  background: #08b96e;
}

.primary-button.is-disabled {
  background: #a7e2c8;
}

.secondary-button {
  background: #08b96e;
}

.button-row {
  display: flex;
  gap: 20rpx;
  margin-top: 30rpx;
}

.button-row .primary-button,
.button-row .secondary-button {
  flex: 1;
  width: auto !important;
  margin-top: 0;
}

/* 身份证上传 */
.upload-box {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  width: 100%;
  margin-top: 4rpx;
  overflow: hidden;
  border: 2rpx dashed #d6dee7;
  border-radius: 16rpx;
  background: #fbfcfd;
}

.id-upload {
  height: 380rpx;
}

.selfie-upload {
  height: 480rpx;
}

.uploaded-image {
  display: block;
  width: 100%;
  height: 100%;
}

.replace-tip {
  position: absolute;
  right: 0;
  bottom: 0;
  left: 0;
  height: 58rpx;
  background: rgba(0, 0, 0, 0.48);
  color: #fff;
  font-size: 23rpx;
  line-height: 58rpx;
  text-align: center;
}

.id-placeholder,
.selfie-placeholder {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 100%;
  padding: 24rpx;
  box-sizing: border-box;
}

/* 身份证示意图 */
.id-illustration {
  position: relative;
  width: 370rpx;
  height: 224rpx;
  margin-bottom: 24rpx;
  overflow: hidden;
  border: 1rpx solid #dbe6f2;
  border-radius: 16rpx;
  background: linear-gradient(135deg, #f2f7fd 0%, #e9f2fb 100%);
}

.id-avatar {
  position: absolute;
  top: 36rpx;
  right: 26rpx;
  width: 62rpx;
  height: 82rpx;
  border-radius: 8rpx;
  background: #c6d8ea;
}

.id-avatar::before {
  content: "";
  position: absolute;
  top: 10rpx;
  left: 18rpx;
  width: 26rpx;
  height: 26rpx;
  border-radius: 50%;
  background: #eef5fc;
}

.id-avatar::after {
  content: "";
  position: absolute;
  right: 10rpx;
  bottom: 0;
  left: 10rpx;
  height: 32rpx;
  border-radius: 18rpx 18rpx 0 0;
  background: #eef5fc;
}

.id-lines {
  position: absolute;
  top: 40rpx;
  left: 30rpx;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.id-lines view {
  width: 190rpx;
  height: 12rpx;
  border-radius: 8rpx;
  background: #c9d8ea;
}

.id-lines view:nth-child(2) {
  width: 150rpx;
}

.id-lines view:nth-child(3) {
  width: 172rpx;
}

.id-lines view:nth-child(4) {
  width: 170rpx;
}

.upload-main {
  color: #4b5563;
  font-size: 29rpx;
  line-height: 1.5;
  text-align: center;
}

.upload-desc {
  margin-top: 8rpx;
  color: #9aa3ad;
  font-size: 23rpx;
  line-height: 1.5;
  text-align: center;
}

/* 本人照片示意图 */
.selfie-avatar {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 180rpx;
  height: 180rpx;
  margin-bottom: 24rpx;
  overflow: hidden;
  border-radius: 50%;
  background: #e7f2ff;
}

.selfie-icon {
  width: 104rpx;
  height: 104rpx;
  opacity: 0.62;
}

.size-check {
  margin-top: 16rpx;
  padding: 18rpx 16rpx;
  border-radius: 10rpx;
  background: #eef6ff;
  color: #5e7d9d;
  font-size: 25rpx;
  line-height: 1.5;
  text-align: center;
}

.size-value {
  color: #2f76b5;
  font-weight: 600;
}

.size-ok {
  color: #08a862;
}

.photo-tips {
  margin-top: 24rpx;
  color: #08a862;
  font-size: 24rpx;
  line-height: 2;
}

/* 身份信息与确认信息 */
.identity-panel {
  margin-top: 24rpx;
  padding: 26rpx 26rpx 30rpx;
  border-radius: 14rpx;
  background: #f7f9fb;
}

.panel-heading {
  color: #1f2937;
  font-size: 29rpx;
  font-weight: 700;
}

.panel-hint {
  margin-top: 8rpx;
  color: #9aa3ad;
  font-size: 22rpx;
  line-height: 1.6;
}

.identity-panel .field-label {
  margin-top: 24rpx;
}

.identity-panel .field-input {
  background: #fff;
}

.identity-grid {
  display: flex;
  gap: 14rpx;
  margin-top: 22rpx;
}

.identity-grid > view {
  flex: 1;
  min-width: 0;
  padding: 18rpx;
  border-radius: 10rpx;
  background: #fff;
}

.small-label {
  display: block;
  color: #9aa3ad;
  font-size: 22rpx;
}

.identity-value {
  display: block;
  margin-top: 8rpx;
  color: #1f2937;
  font-size: 26rpx;
  line-height: 1.4;
  word-break: break-all;
}

.confirm-card {
  margin-top: 24rpx;
  padding: 26rpx;
  border-radius: 14rpx;
  background: #f7f8fa;
}

.confirm-title {
  margin-bottom: 8rpx;
  color: #1f2937;
  font-size: 29rpx;
  font-weight: 700;
}

.confirm-row {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 30rpx;
  padding: 18rpx 0;
  border-bottom: 1rpx solid #e9edf2;
  color: #1f2937;
  font-size: 27rpx;
  line-height: 1.5;
}

.confirm-row:last-child {
  border-bottom: 0;
}

.confirm-row text:first-child {
  flex: none;
  color: #9aa3ad;
}

.confirm-row text:last-child {
  text-align: right;
  word-break: break-all;
}

.contact-card {
  margin-top: 20rpx;
}

.privacy-note {
  margin-top: 24rpx;
  padding: 20rpx 22rpx;
  border-radius: 10rpx;
  background: #fff7e8;
  color: #c48a2c;
  font-size: 24rpx;
  line-height: 1.7;
}
