/* 交易明细：按月份和收入/支出筛选后端推导的演示账单：本文件控制页面外观，不发请求、不改数据库。 */
page {
  background: #f5f5f5; /* 背景：#f5f5f5 */
}

.transactions-filter {
  padding: 18rpx 16rpx; /* 内边距：内容到边框之间的间距；此处按 上下、左右 设置为 18rpx 16rpx。 */
  background: #fff; /* 背景：#fff */
  color: #555; /* 文字颜色：#555 */
  font-size: 25rpx; /* 字号：25rpx */
}

.transactions-month {
  display: flex; /* 启用弹性布局，排列内部元素 */
  justify-content: space-between; /* 两端贴边，中间空隙均分 */
  align-items: center; /* 子元素沿交叉轴居中 */
  padding: 20rpx 16rpx; /* 内边距：内容到边框之间的间距；此处按 上下、左右 设置为 20rpx 16rpx。 */
  color: #444; /* 文字颜色：#444 */
  font-size: 24rpx; /* 字号：24rpx */
}

.transactions-totals {
  color: #999; /* 文字颜色：#999 */
  font-size: 21rpx; /* 字号：21rpx */
}

.transaction-list {
  background: #fff; /* 背景：#fff */
}

.transaction-item {
  display: flex; /* 启用弹性布局，排列内部元素 */
  align-items: center; /* 子元素沿交叉轴居中 */
  min-height: 120rpx; /* 最小高度，内容多时可以增高：120rpx */
  padding: 16rpx 20rpx; /* 内边距：内容到边框之间的间距；此处按 上下、左右 设置为 16rpx 20rpx。 */
  box-sizing: border-box; /* 设置的宽高包含内边距和边框 */
}

.transaction-item + .transaction-item {
  border-top: 1rpx solid #f2f2f2; /* 设置 border-top 为 1rpx solid #f2f2f2；宽度、线型、颜色可一起写，solid 实线、dashed 虚线，none/0 取消边框，transparent 为透明颜色。 */
}

.transaction-icon {
  display: flex; /* 启用弹性布局，排列内部元素 */
  align-items: center; /* 子元素沿交叉轴居中 */
  justify-content: center; /* 子元素沿主轴居中 */
  flex-shrink: 0; /* 空间不足时不压缩 */
  width: 42rpx; /* 宽度：42rpx */
  height: 42rpx; /* 高度：42rpx */
  margin-right: 20rpx; /* 右外边距：20rpx */
  border: 2rpx solid #0bd565; /* 设置 border 为 2rpx solid #0bd565；宽度、线型、颜色可一起写，solid 实线、dashed 虚线，none/0 取消边框，transparent 为透明颜色。 */
  border-radius: 50%; /* 设置圆角为 50%；一个值应用四角，四个值依次为左上、右上、右下、左下；50% 在正方形上得到圆形。 */
  color: #0bd565; /* 文字颜色：#0bd565 */
  font-size: 25rpx; /* 字号：25rpx */
}

.transaction-info {
  flex: 1; /* 按权重 1 分配剩余空间，并允许压缩 */
  min-width: 0; /* 允许子元素缩小，避免长内容撑宽布局 */
}

.transaction-title {
  color: #333; /* 文字颜色：#333 */
  font-size: 26rpx; /* 字号：26rpx */
}

.transaction-time {
  margin-top: 12rpx; /* 上外边距：12rpx */
  color: #999; /* 文字颜色：#999 */
  font-size: 22rpx; /* 字号：22rpx */
}

.transaction-amount {
  flex-shrink: 0; /* 空间不足时不压缩 */
  margin-left: 16rpx; /* 左外边距：16rpx */
  color: #333; /* 文字颜色：#333 */
  font-size: 28rpx; /* 字号：28rpx */
}

.transaction-end {
  padding: 30rpx 0; /* 内边距：内容到边框之间的间距；此处按 上下、左右 设置为 30rpx 0。 */
  color: #aaa; /* 文字颜色：#aaa */
  font-size: 23rpx; /* 字号：23rpx */
  text-align: center; /* 文字水平居中 */
}

.transaction-icon.payment-icon {
  border-radius: 2rpx; /* 设置圆角为 2rpx；一个值应用四角，四个值依次为左上、右上、右下、左下；50% 在正方形上得到圆形。 */
}

.transactions-filter > text {
  display: inline-block; /* 行内排列，同时可设置宽高 */
  padding: 8rpx 18rpx; /* 内边距：内容到边框之间的间距；此处按 上下、左右 设置为 8rpx 18rpx。 */
  border-radius: 28rpx; /* 设置圆角为 28rpx；一个值应用四角，四个值依次为左上、右上、右下、左下；50% 在正方形上得到圆形。 */
  background: #f5f5f5; /* 背景：#f5f5f5 */
}
