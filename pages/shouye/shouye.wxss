.orders-panel .order-status {
  margin: 0; /* 外边距：元素外侧的间距；此处按 四边 设置为 0。 */
  padding: 7rpx 14rpx; /* 内边距：内容到边框之间的间距；此处按 上下、左右 设置为 7rpx 14rpx。 */
  border-radius: 6rpx; /* 设置圆角为 6rpx；一个值应用四角，四个值依次为左上、右上、右下、左下；50% 在正方形上得到圆形。 */
  background: #f1f1f1; /* 背景：#f1f1f1 */
  color: #555; /* 文字颜色：#555 */
  font-size: 23rpx; /* 字号：23rpx */
  white-space: nowrap; /* 文字不自动换行 */
}

.market-panel .status-accepted,
.orders-panel .status-accepted {
  background: #0052d9; /* 背景：#0052d9 */
  color: #fff; /* 文字颜色：#fff */
}

.market-panel .order-remaining,
.orders-panel .order-remaining {
  margin-top: 10rpx; /* 上外边距：10rpx */
  color: #9aa3af; /* 文字颜色：#9aa3af */
  font-size: 22rpx; /* 字号：22rpx */
  text-align: right; /* 文字右对齐 */
}

/* ===== 首页新增：轮播图、公告条、公告中心入口、强提醒弹窗 ===== */

.home-banner {
  position: relative;
  height: 272rpx;
  margin: 20rpx 32rpx 0;
  border-radius: 28rpx;
  overflow: hidden;
  background: #0aa85a;
  box-shadow: 0 16rpx 32rpx rgba(4, 126, 73, 0.16);
}

.banner-swiper {
  width: 100%;
  height: 100%;
}

.banner-image {
  display: block;
  width: 100%;
  height: 100%;
}

/* 标题/副标题落在背景图左侧安全区，换文案不需要重新做图。 */
.banner-copy {
  position: absolute;
  top: 60rpx;
  left: 44rpx;
  z-index: 1;
  width: 340rpx;
}

.banner-title {
  display: -webkit-box;
  overflow: hidden;
  color: #fff;
  font-size: 38rpx;
  font-weight: 700;
  line-height: 1.16;
  letter-spacing: 1rpx;
  text-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.10);
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.banner-sub {
  overflow: hidden;
  margin-top: 14rpx;
  color: rgba(255, 255, 255, 0.88);
  font-size: 20rpx;
  line-height: 1.4;
  letter-spacing: 0.5rpx;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.banner-tag {
  position: absolute;
  top: 20rpx;
  left: 20rpx;
  z-index: 2;
  padding: 6rpx 14rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.45);
  border-radius: 8rpx;
  background: rgba(255, 255, 255, 0.18);
  color: #fff;
  font-size: 19rpx;
  letter-spacing: 1rpx;
}

.banner-cta {
  position: absolute;
  right: 22rpx;
  bottom: 22rpx;
  z-index: 2;
  display: flex;
  align-items: center;
  gap: 4rpx;
  padding: 6rpx 14rpx;
  border-radius: 20rpx;
  background: rgba(0, 0, 0, 0.18);
  color: rgba(255, 255, 255, 0.94);
  font-size: 19rpx;
}

.banner-cta-arrow {
  width: 8rpx;
  height: 8rpx;
  border-top: 2rpx solid rgba(255, 255, 255, 0.9);
  border-right: 2rpx solid rgba(255, 255, 255, 0.9);
  transform: rotate(45deg);
}

.banner-dots {
  position: absolute;
  left: 24rpx;
  bottom: 22rpx;
  z-index: 3;
  display: flex;
  gap: 8rpx;
}

.banner-dot {
  width: 8rpx;
  height: 8rpx;
  border-radius: 4rpx;
  background: rgba(255, 255, 255, 0.45);
  transition: width 0.2s;
}

.banner-dot.active {
  width: 28rpx;
  background: #fff;
}

.banner-fallback {
  box-sizing: border-box;
  width: 100%;
  height: 100%;
  padding: 28rpx 30rpx;
  background: linear-gradient(116deg, #067848, #09ad5c 48%, #46d98b);
  color: #fff;
}

.banner-fallback-tag {
  display: inline-block;
  padding: 6rpx 14rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.45);
  border-radius: 8rpx;
  background: rgba(255, 255, 255, 0.18);
  font-size: 19rpx;
}

.banner-fallback-title {
  margin-top: 22rpx;
  font-size: 38rpx;
  font-weight: 600;
}

.banner-fallback-sub {
  margin-top: 10rpx;
  color: rgba(255, 255, 255, 0.86);
  font-size: 22rpx;
}

.notice-bar {
  display: flex;
  align-items: center;
  height: 92rpx;
  margin: 20rpx 32rpx 0;
  padding: 0 16rpx 0 12rpx;
  border-radius: 24rpx;
  background: #fff;
  box-shadow: 0 2rpx 8rpx rgba(16, 24, 40, 0.03);
}

.notice-main {
  display: flex;
  flex: 1;
  align-items: center;
  min-width: 0;
}

.notice-icon {
  display: flex;
  flex: none;
  align-items: center;
  justify-content: center;
  width: 56rpx;
  height: 56rpx;
  border-radius: 18rpx;
  background: #e9f9f0;
}

.notice-icon-image {
  width: 32rpx;
  height: 32rpx;
}

.notice-title {
  display: flex;
  flex: 1;
  align-items: center;
  min-width: 0;
  margin-left: 16rpx;
  overflow: hidden;
  color: #333;
  font-size: 25rpx;
  white-space: nowrap;
}

.notice-label {
  flex: none;
  margin-right: 8rpx;
  color: #0aa85a;
  font-weight: 600;
}

.notice-text {
  flex: 1;
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.notice-divider {
  flex: none;
  width: 1rpx;
  height: 32rpx;
  margin: 0 16rpx 0 12rpx;
  background: #eceef0;
}

.notice-more {
  display: flex;
  flex: none;
  align-items: center;
  gap: 6rpx;
  color: #0a8f4b;
  font-size: 23rpx;
}

.notice-bell-wrap {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 28rpx;
  height: 28rpx;
}

.notice-bell {
  width: 28rpx;
  height: 28rpx;
}

.notice-red-dot {
  position: absolute;
  top: -2rpx;
  right: -2rpx;
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #fa5151;
  box-shadow: 0 0 0 3rpx #fff;
}

.notice-chevron {
  width: 9rpx;
  height: 9rpx;
  margin-left: 2rpx;
  border-top: 2rpx solid #0a8f4b;
  border-right: 2rpx solid #0a8f4b;
  transform: rotate(45deg);
}

.market-section-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 28rpx 32rpx 14rpx;
}

.market-section-title {
  display: flex;
  align-items: center;
  gap: 10rpx;
  color: #222;
  font-size: 25rpx;
  font-weight: 600;
}

.market-section-title::before {
  content: "";
  width: 6rpx;
  height: 24rpx;
  border-radius: 4rpx;
  background: #0bd565;
}

.market-section-count {
  color: #a3aab3;
  font-size: 21rpx;
}

/* 让订单卡片与轮播、公告条使用同一条左右边界。 */
.market-panel {
  padding: 0 32rpx 170rpx;
}

/* ===== 登录后强提醒弹窗 ===== */

.notice-mask {
  position: fixed;
  inset: 0;
  z-index: 100;
  display: flex;
  align-items: center;
  justify-content: center;
}

.notice-mask-bg {
  position: absolute;
  inset: 0;
  background: rgba(9, 15, 20, 0.54);
}

.notice-dialog {
  position: relative;
  z-index: 2;
  display: flex;
  flex-direction: column;
  width: 644rpx;
  max-height: 88vh;
  overflow: hidden;
  border-radius: 40rpx;
  background: #fff;
  box-shadow: 0 48rpx 120rpx rgba(8, 16, 24, 0.32);
}

.notice-dialog-head {
  padding: 44rpx 44rpx 0;
  text-align: center;
}

.notice-dialog-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 88rpx;
  height: 88rpx;
  margin: 0 auto;
  border-radius: 28rpx;
  background: #eafaf0;
}

.notice-dialog-icon-image {
  width: 48rpx;
  height: 48rpx;
}

.notice-dialog-kicker {
  margin-top: 20rpx;
  color: #98a1aa;
  font-size: 20rpx;
}

.notice-level {
  display: inline-block;
  margin-right: 10rpx;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  background: #fff0f0;
  color: #e5484d;
  font-size: 19rpx;
  font-weight: 600;
}

.notice-dialog-title {
  display: -webkit-box;
  margin-top: 12rpx;
  overflow: hidden;
  color: #1b2127;
  font-size: 36rpx;
  font-weight: 600;
  line-height: 1.45;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.notice-dialog-meta {
  margin-top: 10rpx;
  color: #aab1b9;
  font-size: 19rpx;
}

.notice-dialog-body {
  box-sizing: border-box;
  height: 430rpx;
  margin-top: 24rpx;
  padding: 0 40rpx;
}

.notice-dialog-content {
  display: block;
  color: #5a636d;
  font-size: 24rpx;
  line-height: 1.9;
  white-space: pre-wrap;
  word-break: break-word;
}

.notice-dialog-foot {
  margin-top: 18rpx;
  padding: 20rpx 36rpx 30rpx;
  border-top: 1rpx solid #f0f2f4;
}

.notice-progress {
  height: 6rpx;
  margin-bottom: 20rpx;
  overflow: hidden;
  border-radius: 3rpx;
  background: #eef1f3;
}

.notice-progress-inner {
  height: 100%;
  border-radius: 3rpx;
  background: linear-gradient(90deg, #0bd565, #25df87);
  transition: width 0.2s linear;
}

.notice-close {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  height: 86rpx;
  border-radius: 22rpx;
  background: #f0f2f4;
  color: #9aa3af;
  font-size: 25rpx;
  font-weight: 600;
}

.notice-close.ready {
  background: #0bd565;
  color: #fff;
}

.notice-clock {
  position: relative;
  width: 28rpx;
  height: 28rpx;
  border: 2rpx solid #a4acb4;
  border-radius: 50%;
}

.notice-clock::before {
  content: "";
  position: absolute;
  top: 5rpx;
  left: 50%;
  width: 2rpx;
  height: 8rpx;
  background: #a4acb4;
  transform: translateX(-50%);
}

.notice-clock::after {
  content: "";
  position: absolute;
  top: 11rpx;
  left: 50%;
  width: 6rpx;
  height: 2rpx;
  background: #a4acb4;
  transform-origin: left center;
  transform: rotate(20deg);
}

.notice-dialog-tip {
  margin-top: 12rpx;
  color: #b6bcc3;
  font-size: 18rpx;
  text-align: center;
}
