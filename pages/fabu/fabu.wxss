/* 发布取件需求：驿站、取件码、包裹大小、送达地址、期限和报酬：本文件控制页面外观，不发请求、不改数据库。 */
page {
  background: #f5f5f5; /* 背景：#f5f5f5 */
}

.publish-page {
  padding: 18rpx 18rpx 140rpx; /* 内边距：内容到边框之间的间距；此处按 上、左右、下 设置为 18rpx 18rpx 140rpx。 */
}

.form-card {
  padding: 22rpx; /* 内边距：内容到边框之间的间距；此处按 四边 设置为 22rpx。 */
  border-radius: 12rpx; /* 设置圆角为 12rpx；一个值应用四角，四个值依次为左上、右上、右下、左下；50% 在正方形上得到圆形。 */
  background: #fff; /* 背景：#fff */
}

.card-title {
  padding-bottom: 22rpx; /* 下内边距：22rpx */
  border-bottom: 1rpx solid #eee; /* 设置 border-bottom 为 1rpx solid #eee；宽度、线型、颜色可一起写，solid 实线、dashed 虚线，none/0 取消边框，transparent 为透明颜色。 */
  font-size: 30rpx; /* 字号：30rpx */
  font-weight: bold; /* 文字加粗 */
}

.field-label {
  margin: 28rpx 0 14rpx; /* 外边距：元素外侧的间距；此处按 上、左右、下 设置为 28rpx 0 14rpx。 */
  color: #555; /* 文字颜色：#555 */
  font-size: 25rpx; /* 字号：25rpx */
}

.required {
  color: #f36b70; /* 文字颜色：#f36b70 */
}

.field-box,
.code-input,
.size-select {
  height: 72rpx; /* 高度：72rpx */
  box-sizing: border-box; /* 设置的宽高包含内边距和边框 */
  display: flex; /* 启用弹性布局，排列内部元素 */
  align-items: center; /* 子元素沿交叉轴居中 */
  padding: 0 18rpx; /* 内边距：内容到边框之间的间距；此处按 上下、左右 设置为 0 18rpx。 */
  background: #f7f7f7; /* 背景：#f7f7f7 */
  color: #777; /* 文字颜色：#777 */
  font-size: 25rpx; /* 字号：25rpx */
}

.field-box {
  justify-content: center; /* 子元素沿主轴居中 */
}

.code-row {
  display: flex; /* 启用弹性布局，排列内部元素 */
  gap: 12rpx; /* 子元素之间的间隔：12rpx */
}

.code-input {
  flex: 1; /* 按权重 1 分配剩余空间，并允许压缩 */
  min-width: 0; /* 允许子元素缩小，避免长内容撑宽布局 */
}

.size-select {
  width: 130rpx; /* 宽度：130rpx */
  justify-content: center; /* 子元素沿主轴居中 */
}

.add-code {
  margin-top: 18rpx; /* 上外边距：18rpx */
  padding: 18rpx; /* 内边距：内容到边框之间的间距；此处按 四边 设置为 18rpx。 */
  border: 1rpx dashed #8be5b7; /* 设置 border 为 1rpx solid #8be5b7；宽度、线型、颜色可一起写，solid 实线、dashed 虚线，none/0 取消边框，transparent 为透明颜色。 */
  color: #14c973; /* 文字颜色：#14c973 */
  text-align: center; /* 文字水平居中 */
  font-size: 24rpx; /* 字号：24rpx */
}

.size-title {
  margin: 28rpx 0 18rpx; /* 外边距：元素外侧的间距；此处按 上、左右、下 设置为 28rpx 0 18rpx。 */
  color: #999; /* 文字颜色：#999 */
  text-align: center; /* 文字水平居中 */
  font-size: 22rpx; /* 字号：22rpx */
}

.size-options {
  display: flex; /* 启用弹性布局，排列内部元素 */
  justify-content: space-around; /* 子元素两侧分配空隙 */
  padding: 18rpx 0; /* 内边距：内容到边框之间的间距；此处按 上下、左右 设置为 18rpx 0。 */
  background: #fafafa; /* 背景：#fafafa */
}

.size-options view {
  display: flex; /* 启用弹性布局，排列内部元素 */
  flex-direction: column; /* 主轴改为竖直方向，子元素上下排列 */
  align-items: center; /* 子元素沿交叉轴居中 */
  font-size: 46rpx; /* 字号：46rpx */
}

.size-options text {
  margin-top: 8rpx; /* 上外边距：8rpx */
  color: #666; /* 文字颜色：#666 */
  font-size: 22rpx; /* 字号：22rpx */
}

.size-options image {
  width: 136rpx; /* 宽度：136rpx */
  height: 126rpx; /* 高度：126rpx */
}

.code-row {
  margin-top: 10rpx; /* 上外边距：10rpx */
}

.code-delete {
  flex-shrink: 0; /* 空间不足时不压缩 */
  display: flex; /* 启用弹性布局，排列内部元素 */
  align-items: center; /* 子元素沿交叉轴居中 */
  color: #999; /* 文字颜色：#999 */
  font-size: 23rpx; /* 字号：23rpx */
}

.package-summary {
  margin-top: 18rpx; /* 上外边距：18rpx */
  padding: 28rpx 32rpx; /* 内边距：内容到边框之间的间距；此处按 上下、左右 设置为 28rpx 32rpx。 */
  box-sizing: border-box; /* 设置的宽高包含内边距和边框 */
  display: flex; /* 启用弹性布局，排列内部元素 */
  align-items: center; /* 子元素沿交叉轴居中 */
  flex-wrap: wrap; /* 宽度不足时标签自动换行 */
  gap: 16rpx; /* 标签之间的间隔 */
  border: 3rpx solid #7bc2ff; /* 设置 border 为 3rpx solid #7bc2ff；宽度、线型、颜色可一起写，solid 实线、dashed 虚线，none/0 取消边框，transparent 为透明颜色。 */
  border-radius: 14rpx; /* 设置圆角为 14rpx */
  background: #eef8ff; /* 背景：#eef8ff */
}

.summary-pill {
  padding: 16rpx 20rpx; /* 内边距：内容到边框之间的间距；此处按 上下、左右 设置为 16rpx 20rpx。 */
  border-radius: 999rpx; /* 设置为胶囊形圆角 */
  background: #fff; /* 背景：#fff */
  box-shadow: 0 4rpx 10rpx rgba(40, 116, 180, 0.14); /* 白色小卡片的轻微阴影 */
  color: #1677dc; /* 文字颜色：#1677dc */
  font-size: 28rpx; /* 字号：28rpx */
  font-weight: 500; /* 字重：500 */
  line-height: 38rpx; /* 行高：38rpx */
  white-space: nowrap; /* 标签文字不换行 */
}

.delivery-card {
  margin-top: 18rpx; /* 上外边距：18rpx */
}

.delivery-select,
.address-input {
  height: 72rpx; /* 高度：72rpx */
  box-sizing: border-box; /* 设置的宽高包含内边距和边框 */
  padding: 0 18rpx; /* 内边距：内容到边框之间的间距；此处按 上下、左右 设置为 0 18rpx。 */
  border-radius: 6rpx; /* 设置圆角为 6rpx；一个值应用四角，四个值依次为左上、右上、右下、左下；50% 在正方形上得到圆形。 */
  background: #f7f7f7; /* 背景：#f7f7f7 */
  color: #777; /* 文字颜色：#777 */
  font-size: 25rpx; /* 字号：25rpx */
}

.delivery-select {
  display: flex; /* 启用弹性布局，排列内部元素 */
  align-items: center; /* 子元素沿交叉轴居中 */
  justify-content: space-between; /* 两端贴边，中间空隙均分 */
}

.address-input {
  width: 100%; /* 宽度：100% */
}

.picker-mask {
  position: fixed; /* 固定定位，常用于底栏或弹窗 */
  inset: 0; /* 上右下左都贴边，配合定位覆盖区域 */
  z-index: 20; /* 层叠顺序，同一层叠上下文中比较：20 */
  background: rgba(0, 0, 0, 0.45); /* 背景：rgba(0, 0, 0, 0.45) */
}

.building-picker {
  position: fixed; /* 固定定位，常用于底栏或弹窗 */
  left: 0; /* 设置定位元素的 left 偏移为 0；参照对象由 position 和祖先决定，负数可移出参照边界，auto 表示自动计算。 */
  right: 0; /* 设置定位元素的 right 偏移为 0；参照对象由 position 和祖先决定，负数可移出参照边界，auto 表示自动计算。 */
  bottom: 0; /* 设置定位元素的 bottom 偏移为 0；参照对象由 position 和祖先决定，负数可移出参照边界，auto 表示自动计算。 */
  z-index: 21; /* 层叠顺序，同一层叠上下文中比较：21 */
  height: 78vh; /* 高度：78vh */
  display: flex; /* 启用弹性布局，排列内部元素 */
  flex-direction: column; /* 主轴改为竖直方向，子元素上下排列 */
  overflow: hidden; /* 裁掉超出区域的内容 */
  border-radius: 22rpx 22rpx 0 0; /* 设置圆角为 22rpx 22rpx 0 0；一个值应用四角，四个值依次为左上、右上、右下、左下；50% 在正方形上得到圆形。 */
  background: #fff; /* 背景：#fff */
}

.picker-title {
  position: relative; /* 保留布局占位，作为绝对定位的参照 */
  flex-shrink: 0; /* 空间不足时不压缩 */
  height: 100rpx; /* 高度：100rpx */
  display: flex; /* 启用弹性布局，排列内部元素 */
  align-items: center; /* 子元素沿交叉轴居中 */
  justify-content: center; /* 子元素沿主轴居中 */
  font-size: 30rpx; /* 字号：30rpx */
  font-weight: bold; /* 文字加粗 */
}

.picker-close {
  position: absolute; /* 脱离普通布局，相对定位祖先摆放 */
  right: 28rpx; /* 设置定位元素的 right 偏移为 28rpx；参照对象由 position 和祖先决定，负数可移出参照边界，auto 表示自动计算。 */
  font-size: 42rpx; /* 字号：42rpx */
  font-weight: normal; /* 使用普通字重 */
}

.picker-steps {
  flex-shrink: 0; /* 空间不足时不压缩 */
  padding: 12rpx 28rpx; /* 内边距：内容到边框之间的间距；此处按 上下、左右 设置为 12rpx 28rpx。 */
  border-bottom: 1rpx solid #eee; /* 设置 border-bottom 为 1rpx solid #eee；宽度、线型、颜色可一起写，solid 实线、dashed 虚线，none/0 取消边框，transparent 为透明颜色。 */
}

.picker-step {
  height: 74rpx; /* 高度：74rpx */
  display: flex; /* 启用弹性布局，排列内部元素 */
  align-items: center; /* 子元素沿交叉轴居中 */
  justify-content: space-between; /* 两端贴边，中间空隙均分 */
  font-size: 26rpx; /* 字号：26rpx */
}

.step-left {
  display: flex; /* 启用弹性布局，排列内部元素 */
  align-items: center; /* 子元素沿交叉轴居中 */
  gap: 24rpx; /* 子元素之间的间隔：24rpx */
}

.step-label {
  display: block; /* 设置为块级显示 */
  line-height: 40rpx; /* 设置行盒高度；无单位值乘以字号，rpx 值是明确行高，normal 由字体决定；相同高度和行高常用于单行文字居中；本行值为 40rpx。 */
}

.step-dot,
.step-active,
.option-check {
  color: #10cf72; /* 文字颜色：#10cf72 */
}

.step-dot {
  width: 14rpx; /* 宽度：14rpx */
  height: 14rpx; /* 高度：14rpx */
  flex-shrink: 0; /* 空间不足时不压缩 */
  border-radius: 50%; /* 设置圆角为 50%；一个值应用四角，四个值依次为左上、右上、右下、左下；50% 在正方形上得到圆形。 */
  background: #10cf72; /* 背景：#10cf72 */
}

.step-active {
  font-weight: bold; /* 文字加粗 */
}

.step-arrow {
  color: #999; /* 文字颜色：#999 */
  font-size: 38rpx; /* 字号：38rpx */
}

.picker-list {
  flex: 1; /* 按权重 1 分配剩余空间，并允许压缩 */
  height: 0; /* 高度：0 */
}

.picker-option {
  min-height: 104rpx; /* 最小高度，内容多时可以增高：104rpx */
  box-sizing: border-box; /* 设置的宽高包含内边距和边框 */
  padding: 28rpx; /* 内边距：内容到边框之间的间距；此处按 四边 设置为 28rpx。 */
  display: flex; /* 启用弹性布局，排列内部元素 */
  align-items: center; /* 子元素沿交叉轴居中 */
  justify-content: space-between; /* 两端贴边，中间空隙均分 */
  font-size: 27rpx; /* 字号：27rpx */
}

.option-check {
  font-size: 34rpx; /* 字号：34rpx */
}

.building-search {
  flex-shrink: 0; /* 空间不足时不压缩 */
  display: flex; /* 启用弹性布局，排列内部元素 */
  align-items: center; /* 子元素沿交叉轴居中 */
  gap: 14rpx; /* 子元素之间的间隔：14rpx */
  margin: 12rpx 28rpx 24rpx; /* 外边距：元素外侧的间距；此处按 上、左右、下 设置为 12rpx 28rpx 24rpx。 */
  padding: 0 20rpx; /* 内边距：内容到边框之间的间距；此处按 上下、左右 设置为 0 20rpx。 */
  height: 76rpx; /* 高度：76rpx */
  border-radius: 6rpx; /* 设置圆角为 6rpx；一个值应用四角，四个值依次为左上、右上、右下、左下；50% 在正方形上得到圆形。 */
  background: #f5f5f5; /* 背景：#f5f5f5 */
}

.building-search-input {
  flex: 1; /* 按权重 1 分配剩余空间，并允许压缩 */
  min-width: 0; /* 允许子元素缩小，避免长内容撑宽布局 */
  height: 100%; /* 高度：100% */
  font-size: 28rpx; /* 字号：28rpx */
}

.step-marker {
  position: relative; /* 保留布局占位，作为绝对定位的参照 */
  width: 14rpx; /* 宽度：14rpx */
  height: 14rpx; /* 高度：14rpx */
  flex-shrink: 0; /* 空间不足时不压缩 */
}

.step-connector {
  position: absolute; /* 脱离普通布局，相对定位祖先摆放 */
  top: 14rpx; /* 设置定位元素的 top 偏移为 14rpx；参照对象由 position 和祖先决定，负数可移出参照边界，auto 表示自动计算。 */
  left: 6rpx; /* 设置定位元素的 left 偏移为 6rpx；参照对象由 position 和祖先决定，负数可移出参照边界，auto 表示自动计算。 */
  width: 2rpx; /* 宽度：2rpx */
  height: 60rpx; /* 高度：60rpx */
  background: #10cf72; /* 背景：#10cf72 */
}

.time-price-card {
  margin-top: 18rpx; /* 上外边距：18rpx */
}

.time-price-field {
  height: 72rpx; /* 高度：72rpx */
  box-sizing: border-box; /* 设置的宽高包含内边距和边框 */
  padding: 0 18rpx; /* 内边距：内容到边框之间的间距；此处按 上下、左右 设置为 0 18rpx。 */
  display: flex; /* 启用弹性布局，排列内部元素 */
  align-items: center; /* 子元素沿交叉轴居中 */
  justify-content: space-between; /* 两端贴边，中间空隙均分 */
  border-radius: 6rpx; /* 设置圆角为 6rpx；一个值应用四角，四个值依次为左上、右上、右下、左下；50% 在正方形上得到圆形。 */
  background: #f7f7f7; /* 背景：#f7f7f7 */
  color: #777; /* 文字颜色：#777 */
  font-size: 25rpx; /* 字号：25rpx */
}

.deadline-picker {
  position: fixed; /* 固定定位，常用于底栏或弹窗 */
  left: 0; /* 设置定位元素的 left 偏移为 0；参照对象由 position 和祖先决定，负数可移出参照边界，auto 表示自动计算。 */
  right: 0; /* 设置定位元素的 right 偏移为 0；参照对象由 position 和祖先决定，负数可移出参照边界，auto 表示自动计算。 */
  bottom: 0; /* 设置定位元素的 bottom 偏移为 0；参照对象由 position 和祖先决定，负数可移出参照边界，auto 表示自动计算。 */
  z-index: 21; /* 层叠顺序，同一层叠上下文中比较：21 */
  min-height: 420rpx; /* 最小高度，内容多时可以增高：420rpx */
  border-radius: 22rpx 22rpx 0 0; /* 设置圆角为 22rpx 22rpx 0 0；一个值应用四角，四个值依次为左上、右上、右下、左下；50% 在正方形上得到圆形。 */
  background: #fff; /* 背景：#fff */
}

.deadline-title {
  height: 110rpx; /* 高度：110rpx */
  padding: 0 28rpx; /* 内边距：内容到边框之间的间距；此处按 上下、左右 设置为 0 28rpx。 */
  display: flex; /* 启用弹性布局，排列内部元素 */
  align-items: center; /* 子元素沿交叉轴居中 */
  justify-content: space-between; /* 两端贴边，中间空隙均分 */
  border-bottom: 1rpx solid #eee; /* 设置 border-bottom 为 1rpx solid #eee；宽度、线型、颜色可一起写，solid 实线、dashed 虚线，none/0 取消边框，transparent 为透明颜色。 */
  font-size: 30rpx; /* 字号：30rpx */
  font-weight: bold; /* 文字加粗 */
}

.deadline-section-title {
  padding: 30rpx 28rpx; /* 内边距：内容到边框之间的间距；此处按 上下、左右 设置为 30rpx 28rpx。 */
  font-size: 27rpx; /* 字号：27rpx */
  font-weight: bold; /* 文字加粗 */
}

.deadline-date-scroll {
  width: 100%; /* 宽度：100% */
  white-space: nowrap; /* 文字不自动换行 */
}

.deadline-date-list {
  display: flex; /* 启用弹性布局，排列内部元素 */
  gap: 12rpx; /* 子元素之间的间隔：12rpx */
  padding: 0 20rpx 20rpx; /* 内边距：内容到边框之间的间距；此处按 上、左右、下 设置为 0 20rpx 20rpx。 */
  width: max-content; /* 宽度：max-content */
}

.deadline-date {
  width: 168rpx; /* 宽度：168rpx */
  height: 146rpx; /* 高度：146rpx */
  box-sizing: border-box; /* 设置的宽高包含内边距和边框 */
  flex-shrink: 0; /* 空间不足时不压缩 */
  display: flex; /* 启用弹性布局，排列内部元素 */
  flex-direction: column; /* 主轴改为竖直方向，子元素上下排列 */
  align-items: center; /* 子元素沿交叉轴居中 */
  justify-content: center; /* 子元素沿主轴居中 */
  gap: 12rpx; /* 子元素之间的间隔：12rpx */
  border: 1rpx solid #ddd; /* 设置 border 为 1rpx solid #ddd；宽度、线型、颜色可一起写，solid 实线、dashed 虚线，none/0 取消边框，transparent 为透明颜色。 */
  border-radius: 12rpx; /* 设置圆角为 12rpx；一个值应用四角，四个值依次为左上、右上、右下、左下；50% 在正方形上得到圆形。 */
  font-size: 28rpx; /* 字号：28rpx */
  font-weight: bold; /* 文字加粗 */
}

.deadline-weekday {
  color: #999; /* 文字颜色：#999 */
  font-size: 23rpx; /* 字号：23rpx */
  font-weight: normal; /* 使用普通字重 */
}

.deadline-date.selected {
  border-color: #10cf72; /* 边框颜色：#10cf72 */
  background: #effbf4; /* 背景：#effbf4 */
  color: #10cf72; /* 文字颜色：#10cf72 */
}

.deadline-date.selected .deadline-weekday {
  color: #10cf72; /* 文字颜色：#10cf72 */
}

.deadline-confirm {
  margin: 24rpx auto 30rpx; /* 外边距：元素外侧的间距；此处按 上、左右、下 设置为 24rpx auto 30rpx。 auto 为自动分配；常见的 0 auto 可让有确定宽度的块水平居中，也受布局环境影响。 */
  width: 60%; /* 宽度：60% */
  height: 76rpx; /* 高度：76rpx */
  display: flex; /* 启用弹性布局，排列内部元素 */
  align-items: center; /* 子元素沿交叉轴居中 */
  justify-content: center; /* 子元素沿主轴居中 */
  border-radius: 40rpx; /* 设置圆角为 40rpx；一个值应用四角，四个值依次为左上、右上、右下、左下；50% 在正方形上得到圆形。 */
  background: #10cf72; /* 背景：#10cf72 */
  color: #fff; /* 文字颜色：#fff */
  font-size: 28rpx; /* 字号：28rpx */
  font-weight: bold; /* 文字加粗 */
}

.deadline-time-title {
  padding: 20rpx 28rpx; /* 内边距：内容到边框之间的间距；此处按 上下、左右 设置为 20rpx 28rpx。 */
  font-size: 27rpx; /* 字号：27rpx */
  font-weight: bold; /* 文字加粗 */
}

.deadline-time-grid {
  display: grid; /* 启用网格布局 */
  grid-template-columns: 1fr 1fr; /* 网格分为两列，两列等宽 */
  gap: 12rpx; /* 子元素之间的间隔：12rpx */
  padding: 0 20rpx; /* 内边距：内容到边框之间的间距；此处按 上下、左右 设置为 0 20rpx。 */
}

.deadline-time-option {
  height: 136rpx; /* 高度：136rpx */
  display: flex; /* 启用弹性布局，排列内部元素 */
  flex-direction: column; /* 主轴改为竖直方向，子元素上下排列 */
  align-items: center; /* 子元素沿交叉轴居中 */
  justify-content: center; /* 子元素沿主轴居中 */
  gap: 8rpx; /* 子元素之间的间隔：8rpx */
  background: #f7f7f7; /* 背景：#f7f7f7 */
  font-size: 27rpx; /* 字号：27rpx */
  font-weight: bold; /* 文字加粗 */
}

.deadline-time-option.selected {
  background: #effbf4; /* 背景：#effbf4 */
  color: #10cf72; /* 文字颜色：#10cf72 */
}

.deadline-tip {
  margin: 22rpx 20rpx 0; /* 外边距：元素外侧的间距；此处按 上、左右、下 设置为 22rpx 20rpx 0。 */
  padding: 18rpx; /* 内边距：内容到边框之间的间距；此处按 四边 设置为 18rpx。 */
  background: #f7f7f7; /* 背景：#f7f7f7 */
  color: #888; /* 文字颜色：#888 */
  text-align: center; /* 文字水平居中 */
  font-size: 22rpx; /* 字号：22rpx */
}

.deadline-mode-tabs {
  display: flex; /* 启用弹性布局，排列内部元素 */
  margin: 16rpx 20rpx; /* 外边距：元素外侧的间距；此处按 上下、左右 设置为 16rpx 20rpx。 */
  padding: 4rpx; /* 内边距：内容到边框之间的间距；此处按 四边 设置为 4rpx。 */
  border-radius: 8rpx; /* 设置圆角为 8rpx；一个值应用四角，四个值依次为左上、右上、右下、左下；50% 在正方形上得到圆形。 */
  background: #f4f4f4; /* 背景：#f4f4f4 */
}

.deadline-mode-tabs view {
  flex: 1; /* 按权重 1 分配剩余空间，并允许压缩 */
  height: 64rpx; /* 高度：64rpx */
  display: flex; /* 启用弹性布局，排列内部元素 */
  align-items: center; /* 子元素沿交叉轴居中 */
  justify-content: center; /* 子元素沿主轴居中 */
  color: #777; /* 文字颜色：#777 */
  font-size: 25rpx; /* 字号：25rpx */
}

.deadline-mode-tabs .active {
  border-radius: 6rpx; /* 设置圆角为 6rpx；一个值应用四角，四个值依次为左上、右上、右下、左下；50% 在正方形上得到圆形。 */
  background: #fff; /* 背景：#fff */
  color: #10cf72; /* 文字颜色：#10cf72 */
  font-weight: bold; /* 文字加粗 */
}

.deadline-custom-time {
  padding: 0 20rpx; /* 内边距：内容到边框之间的间距；此处按 上下、左右 设置为 0 20rpx。 */
}

.deadline-wheel-labels {
  display: flex; /* 启用弹性布局，排列内部元素 */
  text-align: center; /* 文字水平居中 */
  color: #777; /* 文字颜色：#777 */
  font-size: 24rpx; /* 字号：24rpx */
}

.deadline-wheel-labels text {
  flex: 1; /* 按权重 1 分配剩余空间，并允许压缩 */
}

.deadline-wheel {
  height: 280rpx; /* 高度：280rpx */
}

.deadline-wheel picker-view-column view {
  height: 80rpx; /* 高度：80rpx */
  display: flex; /* 启用弹性布局，排列内部元素 */
  align-items: center; /* 子元素沿交叉轴居中 */
  justify-content: center; /* 子元素沿主轴居中 */
  font-size: 28rpx; /* 字号：28rpx */
}

.reward-input {
  flex: 1; /* 按权重 1 分配剩余空间，并允许压缩 */
  min-width: 0; /* 允许子元素缩小，避免长内容撑宽布局 */
  height: 100%; /* 高度：100% */
  margin-left: 12rpx; /* 左外边距：12rpx */
  font-size: 25rpx; /* 字号：25rpx */
}

.suggested-price {
  margin-top: 16rpx; /* 上外边距：16rpx */
  padding: 18rpx; /* 内边距：内容到边框之间的间距；此处按 四边 设置为 18rpx。 */
  border: 1rpx solid #8be5b7; /* 设置 border 为 1rpx solid #8be5b7；宽度、线型、颜色可一起写，solid 实线、dashed 虚线，none/0 取消边框，transparent 为透明颜色。 */
  border-radius: 6rpx; /* 设置圆角为 6rpx；一个值应用四角，四个值依次为左上、右上、右下、左下；50% 在正方形上得到圆形。 */
  background: #effbf4; /* 背景：#effbf4 */
  color: #10bf69; /* 文字颜色：#10bf69 */
  text-align: center; /* 文字水平居中 */
  font-size: 24rpx; /* 字号：24rpx */
}

.publish-next {
  box-sizing: border-box; /* 设置的宽高包含内边距和边框 */
  width: 100%; /* 宽度：100% */
  margin: 0; /* 外边距：元素外侧的间距；此处按 四边 设置为 0。 */
  height: 84rpx; /* 高度：84rpx */
  display: flex; /* 启用弹性布局，排列内部元素 */
  align-items: center; /* 子元素沿交叉轴居中 */
  justify-content: center; /* 子元素沿主轴居中 */
  border-radius: 8rpx; /* 设置圆角为 8rpx；一个值应用四角，四个值依次为左上、右上、右下、左下；50% 在正方形上得到圆形。 */
  background: #10cf72; /* 背景：#10cf72 */
  color: #fff; /* 文字颜色：#fff */
  font-size: 30rpx; /* 字号：30rpx */
  font-weight: bold; /* 文字加粗 */
}

.publish-footer {
  position: fixed; /* 固定定位，常用于底栏或弹窗 */
  z-index: 5; /* 层叠顺序，同一层叠上下文中比较：5 */
  right: 0; /* 设置定位元素的 right 偏移为 0；参照对象由 position 和祖先决定，负数可移出参照边界，auto 表示自动计算。 */
  bottom: 0; /* 设置定位元素的 bottom 偏移为 0；参照对象由 position 和祖先决定，负数可移出参照边界，auto 表示自动计算。 */
  left: 0; /* 设置定位元素的 left 偏移为 0；参照对象由 position 和祖先决定，负数可移出参照边界，auto 表示自动计算。 */
  padding: 14rpx 18rpx calc(14rpx + env(safe-area-inset-bottom)); /* 内边距：内容到边框之间的间距；此处按 上、左右、下 设置为 14rpx 18rpx calc(14rpx + env(safe-area-inset-bottom))。 calc() 用于计算长度，例如整体宽度减边距，或基础内边距加安全区。 env(safe-area-inset-*) 读取设备对应边的安全区，避免内容贴住底部手势条等区域。 */
  background: #fff; /* 背景：#fff */
}

.station-mask {
  position: fixed; /* 固定定位，常用于底栏或弹窗 */
  z-index: 20; /* 层叠顺序，同一层叠上下文中比较：20 */
  inset: 0; /* 上右下左都贴边，配合定位覆盖区域 */
  background: transparent; /* 背景：transparent */
}

.station-menu {
  position: fixed; /* 固定定位，常用于底栏或弹窗 */
  z-index: 21; /* 层叠顺序，同一层叠上下文中比较：21 */
  top: 45%; /* 设置定位元素的 top 偏移为 45%；参照对象由 position 和祖先决定，负数可移出参照边界，auto 表示自动计算。 */
  left: 50%; /* 设置定位元素的 left 偏移为 50%；参照对象由 position 和祖先决定，负数可移出参照边界，auto 表示自动计算。 */
  width: 280rpx; /* 宽度：280rpx */
  transform: translate(-50%, -50%); /* 变换元素：translate(-50%, -50%)；rotate 用 deg 表示旋转角度，translate 的百分比通常按自身尺寸计算；translateY(-50%) 向上移动自身高度的一半。 */
  padding: 14rpx 0; /* 内边距：内容到边框之间的间距；此处按 上下、左右 设置为 14rpx 0。 */
  border-radius: 8rpx; /* 设置圆角为 8rpx；一个值应用四角，四个值依次为左上、右上、右下、左下；50% 在正方形上得到圆形。 */
  background: #fff; /* 背景：#fff */
  box-shadow: 0 4rpx 20rpx rgba(0,0,0,.16); /* 添加阴影；依次是水平偏移、垂直偏移、模糊半径和颜色；本行值为 0 4rpx 20rpx rgba(0,0,0,.16)。 rgba() 的前三项是红绿蓝，最后一项是透明度，0 全透明、1 不透明。 */
}

.station-menu view {
  padding: 20rpx 16rpx; /* 内边距：内容到边框之间的间距；此处按 上下、左右 设置为 20rpx 16rpx。 */
  text-align: center; /* 文字水平居中 */
  font-size: 26rpx; /* 字号：26rpx */
  color: #222; /* 文字颜色：#222 */
}
