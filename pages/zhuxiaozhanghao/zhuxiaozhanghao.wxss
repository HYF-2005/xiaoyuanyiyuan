/* 注销账户：确认协议和密码；后端停用账号并保留历史记录：本文件控制页面外观，不发请求、不改数据库。 */
page {
  background: #f5f5f5; /* 背景：#f5f5f5 */
}

.cancel-page {
  padding: 0 24rpx 40rpx; /* 内边距：内容到边框之间的间距；此处按 上、左右、下 设置为 0 24rpx 40rpx。 */
}

.cancel-password-wrap {
  display: flex; /* 启用弹性布局，排列内部元素 */
  align-items: center; /* 子元素沿交叉轴居中 */
  margin-top: 20rpx; /* 上外边距：20rpx */
  background: #fff; /* 背景：#fff */
  border-radius: 8rpx; /* 设置圆角为 8rpx；一个值应用四角，四个值依次为左上、右上、右下、左下；50% 在正方形上得到圆形。 */
}

.cancel-password {
  flex: 1; /* 按权重 1 分配剩余空间，并允许压缩 */
  min-width: 0; /* 允许子元素缩小，避免长内容撑宽布局 */
  height: 90rpx; /* 高度：90rpx */
  padding: 0 24rpx; /* 内边距：内容到边框之间的间距；此处按 上下、左右 设置为 0 24rpx。 */
  font-size: 27rpx; /* 字号：27rpx */
}

.cancel-card {
  padding: 28rpx; /* 内边距：内容到边框之间的间距；此处按 四边 设置为 28rpx。 */
  border-radius: 10rpx; /* 设置圆角为 10rpx；一个值应用四角，四个值依次为左上、右上、右下、左下；50% 在正方形上得到圆形。 */
  background: #fff; /* 背景：#fff */
  color: #333; /* 文字颜色：#333 */
  font-size: 27rpx; /* 字号：27rpx */
}

.cancel-title {
  padding-bottom: 22rpx; /* 下内边距：22rpx */
  border-bottom: 1rpx solid #eee; /* 设置 border-bottom 为 1rpx solid #eee；宽度、线型、颜色可一起写，solid 实线、dashed 虚线，none/0 取消边框，transparent 为透明颜色。 */
  font-size: 30rpx; /* 字号：30rpx */
  font-weight: bold; /* 文字加粗 */
}

.cancel-intro {
  margin-top: 28rpx; /* 上外边距：28rpx */
  line-height: 1.6; /* 设置行盒高度；无单位值乘以字号，rpx 值是明确行高，normal 由字体决定；相同高度和行高常用于单行文字居中；本行值为 1.6。 */
}

.cancel-terms {
  padding: 22rpx; /* 内边距：内容到边框之间的间距；此处按 四边 设置为 22rpx。 */
  border-radius: 8rpx; /* 设置圆角为 8rpx；一个值应用四角，四个值依次为左上、右上、右下、左下；50% 在正方形上得到圆形。 */
  background: #fafafa; /* 背景：#fafafa */
  line-height: 1.7; /* 设置行盒高度；无单位值乘以字号，rpx 值是明确行高，normal 由字体决定；相同高度和行高常用于单行文字居中；本行值为 1.7。 */
}

.cancel-terms-title {
  margin-bottom: 14rpx; /* 下外边距：14rpx */
  font-weight: bold; /* 文字加粗 */
}

.cancel-term {
  margin-bottom: 10rpx; /* 下外边距：10rpx */
  color: #888; /* 文字颜色：#888 */
  font-size: 24rpx; /* 字号：24rpx */
}

.cancel-dot {
  color: #0bd565; /* 文字颜色：#0bd565 */
}

.cancel-contact {
  margin-top: 20rpx; /* 上外边距：20rpx */
  padding: 20rpx; /* 内边距：内容到边框之间的间距；此处按 四边 设置为 20rpx。 */
  border-left: 4rpx solid #4aa3ff; /* 设置 border-left 为 4rpx solid #4aa3ff；宽度、线型、颜色可一起写，solid 实线、dashed 虚线，none/0 取消边框，transparent 为透明颜色。 */
  background: #eef8ff; /* 背景：#eef8ff */
  color: #777; /* 文字颜色：#777 */
  font-size: 23rpx; /* 字号：23rpx */
  line-height: 1.7; /* 设置行盒高度；无单位值乘以字号，rpx 值是明确行高，normal 由字体决定；相同高度和行高常用于单行文字居中；本行值为 1.7。 */
}

.cancel-contact-email {
  margin-top: 6rpx; /* 上外边距：6rpx */
  color: #4aa3ff; /* 文字颜色：#4aa3ff */
}

.cancel-agreement {
  display: flex; /* 启用弹性布局，排列内部元素 */
  align-items: center; /* 子元素沿交叉轴居中 */
  margin-top: 20rpx; /* 上外边距：20rpx */
  padding: 24rpx; /* 内边距：内容到边框之间的间距；此处按 四边 设置为 24rpx。 */
  border-radius: 10rpx; /* 设置圆角为 10rpx；一个值应用四角，四个值依次为左上、右上、右下、左下；50% 在正方形上得到圆形。 */
  background: #fff; /* 背景：#fff */
  color: #333; /* 文字颜色：#333 */
  font-size: 24rpx; /* 字号：24rpx */
}

.cancel-checkbox {
  display: flex; /* 启用弹性布局，排列内部元素 */
  align-items: center; /* 子元素沿交叉轴居中 */
  justify-content: center; /* 子元素沿主轴居中 */
  flex-shrink: 0; /* 空间不足时不压缩 */
  width: 32rpx; /* 宽度：32rpx */
  height: 32rpx; /* 高度：32rpx */
  margin-right: 14rpx; /* 右外边距：14rpx */
  border: 1rpx solid #ddd; /* 设置 border 为 1rpx solid #ddd；宽度、线型、颜色可一起写，solid 实线、dashed 虚线，none/0 取消边框，transparent 为透明颜色。 */
  border-radius: 6rpx; /* 设置圆角为 6rpx；一个值应用四角，四个值依次为左上、右上、右下、左下；50% 在正方形上得到圆形。 */
  color: #fff; /* 文字颜色：#fff */
  font-size: 24rpx; /* 字号：24rpx */
}

.cancel-checkbox.checked {
  border-color: #c9343e; /* 边框颜色：#c9343e */
  background: #c9343e; /* 背景：#c9343e */
}

.cancel-submit {
  height: 96rpx; /* 高度：96rpx */
  margin-top: 20rpx; /* 上外边距：20rpx */
  border-radius: 8rpx; /* 设置圆角为 8rpx；一个值应用四角，四个值依次为左上、右上、右下、左下；50% 在正方形上得到圆形。 */
  background: #c9343e; /* 背景：#c9343e */
  color: #fff; /* 文字颜色：#fff */
  font-size: 28rpx; /* 字号：28rpx */
  font-weight: bold; /* 文字加粗 */
}

.cancel-submit[disabled] {
  background: #f5b0b4; /* 背景：#f5b0b4 */
  color: #fff; /* 文字颜色：#fff */
}

.cancel-submit::after {
  border: none; /* 设置 border 为 none；宽度、线型、颜色可一起写，solid 实线、dashed 虚线，none/0 取消边框，transparent 为透明颜色。 */
}

.cancel-note {
  margin-top: 18rpx; /* 上外边距：18rpx */
  color: #aaa; /* 文字颜色：#aaa */
  font-size: 22rpx; /* 字号：22rpx */
  text-align: center; /* 文字水平居中 */
}
