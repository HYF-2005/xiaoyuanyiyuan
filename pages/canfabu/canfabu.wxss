/* 发布取餐需求：餐厅三级联动、取餐码、地址、时间与建议报酬：本文件控制页面外观，不发请求、不改数据库。 */
page {
  background: #f5f5f5; /* 背景：#f5f5f5 */
}

.meal-page {
  padding: 18rpx 16rpx 140rpx; /* 内边距：内容到边框之间的间距；此处按 上、左右、下 设置为 18rpx 16rpx 140rpx。 */
}

.meal-card {
  margin-bottom: 16rpx; /* 下外边距：16rpx */
  padding: 22rpx; /* 内边距：内容到边框之间的间距；此处按 四边 设置为 22rpx。 */
  border-radius: 10rpx; /* 设置圆角为 10rpx；一个值应用四角，四个值依次为左上、右上、右下、左下；50% 在正方形上得到圆形。 */
  background: #fff; /* 背景：#fff */
}

.meal-card-title {
  margin-bottom: 22rpx; /* 下外边距：22rpx */
  padding-bottom: 20rpx; /* 下内边距：20rpx */
  border-bottom: 1rpx solid #eee; /* 设置 border-bottom 为 1rpx solid #eee；宽度、线型、颜色可一起写，solid 实线、dashed 虚线，none/0 取消边框，transparent 为透明颜色。 */
  color: #222; /* 文字颜色：#222 */
  font-size: 29rpx; /* 字号：29rpx */
  font-weight: bold; /* 文字加粗 */
}

/* 原有孤立文本不是有效样式声明，保留为注释：rgb(33, 7, 7)rgb(46, 30, 30) */

.meal-label {
  margin: 20rpx 0 12rpx; /* 外边距：元素外侧的间距；此处按 上、左右、下 设置为 20rpx 0 12rpx。 */
  color: #666; /* 文字颜色：#666 */
  font-size: 25rpx; /* 字号：25rpx */
}

.required {
  color: #f46c73; /* 文字颜色：#f46c73 */
}

.meal-input, .meal-select, .meal-money {
  box-sizing: border-box; /* 设置的宽高包含内边距和边框 */
  width: 100%; /* 宽度：100% */
  height: 76rpx; /* 高度：76rpx */
  padding: 0 18rpx; /* 内边距：内容到边框之间的间距；此处按 上下、左右 设置为 0 18rpx。 */
  border: 1rpx solid #eee; /* 设置 border 为 1rpx solid #eee；宽度、线型、颜色可一起写，solid 实线、dashed 虚线，none/0 取消边框，transparent 为透明颜色。 */
  border-radius: 5rpx; /* 设置圆角为 5rpx；一个值应用四角，四个值依次为左上、右上、右下、左下；50% 在正方形上得到圆形。 */
  background: #f8f8f8; /* 背景：#f8f8f8 */
  color: #333; /* 文字颜色：#333 */
  font-size: 25rpx; /* 字号：25rpx */
}

.meal-select {
  display: flex; /* 启用弹性布局，排列内部元素 */
  align-items: center; /* 子元素沿交叉轴居中 */
  justify-content: space-between; /* 两端贴边，中间空隙均分 */
}

.meal-select text {
  color: #999; /* 文字颜色：#999 */
  font-size: 36rpx; /* 字号：36rpx */
}

.meal-code-row {
  display: flex; /* 启用弹性布局，排列内部元素 */
  align-items: center; /* 子元素沿交叉轴居中 */
  gap: 12rpx; /* 子元素之间的间隔：12rpx */
  margin-bottom: 10rpx; /* 下外边距：10rpx */
}

.meal-code-input {
  flex: 1; /* 按权重 1 分配剩余空间，并允许压缩 */
  width: 0; /* 宽度：0 */
  text-align: center; /* 文字水平居中 */
}

.meal-delete {
  display: flex; /* 启用弹性布局，排列内部元素 */
  align-items: center; /* 子元素沿交叉轴居中 */
  justify-content: center; /* 子元素沿主轴居中 */
  width: 46rpx; /* 宽度：46rpx */
  height: 76rpx; /* 高度：76rpx */
  color: #777; /* 文字颜色：#777 */
}

.trash-icon {
  position: relative; /* 保留布局占位，作为绝对定位的参照 */
  box-sizing: border-box; /* 设置的宽高包含内边距和边框 */
  width: 27rpx; /* 宽度：27rpx */
  height: 30rpx; /* 高度：30rpx */
  border: 3rpx solid #777; /* 设置 border 为 3rpx solid #777；宽度、线型、颜色可一起写，solid 实线、dashed 虚线，none/0 取消边框，transparent 为透明颜色。 */
  border-radius: 0 0 4rpx 4rpx; /* 设置圆角为 0 0 4rpx 4rpx；一个值应用四角，四个值依次为左上、右上、右下、左下；50% 在正方形上得到圆形。 */
}

.trash-icon::before {
  content: ''; /* 生成空伪元素，用于绘制装饰 */
  position: absolute; /* 脱离普通布局，相对定位祖先摆放 */
  top: -9rpx; /* 设置定位元素的 top 偏移为 -9rpx；参照对象由 position 和祖先决定，负数可移出参照边界，auto 表示自动计算。 */
  left: -6rpx; /* 设置定位元素的 left 偏移为 -6rpx；参照对象由 position 和祖先决定，负数可移出参照边界，auto 表示自动计算。 */
  width: 33rpx; /* 宽度：33rpx */
  height: 3rpx; /* 高度：3rpx */
  background: #777; /* 背景：#777 */
}

.trash-icon::after {
  content: ''; /* 生成空伪元素，用于绘制装饰 */
  position: absolute; /* 脱离普通布局，相对定位祖先摆放 */
  top: 3rpx; /* 设置定位元素的 top 偏移为 3rpx；参照对象由 position 和祖先决定，负数可移出参照边界，auto 表示自动计算。 */
  bottom: 3rpx; /* 设置定位元素的 bottom 偏移为 3rpx；参照对象由 position 和祖先决定，负数可移出参照边界，auto 表示自动计算。 */
  left: 7rpx; /* 设置定位元素的 left 偏移为 7rpx；参照对象由 position 和祖先决定，负数可移出参照边界，auto 表示自动计算。 */
  width: 3rpx; /* 宽度：3rpx */
  background: #777; /* 背景：#777 */
}

.meal-add {
  padding: 20rpx; /* 内边距：内容到边框之间的间距；此处按 四边 设置为 20rpx。 */
  border: 1rpx dashed #0bd565; /* 设置 border 为 1rpx dashed #0bd565；宽度、线型、颜色可一起写，solid 实线、dashed 虚线，none/0 取消边框，transparent 为透明颜色。 */
  border-radius: 5rpx; /* 设置圆角为 5rpx；一个值应用四角，四个值依次为左上、右上、右下、左下；50% 在正方形上得到圆形。 */
  color: #0bd565; /* 文字颜色：#0bd565 */
  font-size: 24rpx; /* 字号：24rpx */
  text-align: center; /* 文字水平居中 */
}

.meal-summary {
  margin-top: 14rpx; /* 上外边距：14rpx */
  padding: 12rpx; /* 内边距：内容到边框之间的间距；此处按 四边 设置为 12rpx。 */
  border: 1rpx solid #b7def3; /* 设置 border 为 1rpx solid #b7def3；宽度、线型、颜色可一起写，solid 实线、dashed 虚线，none/0 取消边框，transparent 为透明颜色。 */
  border-radius: 5rpx; /* 设置圆角为 5rpx；一个值应用四角，四个值依次为左上、右上、右下、左下；50% 在正方形上得到圆形。 */
  background: #e8f6ff; /* 背景：#e8f6ff */
  color: #479ed1; /* 文字颜色：#479ed1 */
  font-size: 22rpx; /* 字号：22rpx */
}

.meal-summary text {
  display: inline-block; /* 行内排列，同时可设置宽高 */
  padding: 5rpx 12rpx; /* 内边距：内容到边框之间的间距；此处按 上下、左右 设置为 5rpx 12rpx。 */
  border-radius: 16rpx; /* 设置圆角为 16rpx；一个值应用四角，四个值依次为左上、右上、右下、左下；50% 在正方形上得到圆形。 */
  background: #fff; /* 背景：#fff */
}

.meal-money {
  display: flex; /* 启用弹性布局，排列内部元素 */
  align-items: center; /* 子元素沿交叉轴居中 */
  gap: 12rpx; /* 子元素之间的间隔：12rpx */
}

.meal-money input {
  flex: 1; /* 按权重 1 分配剩余空间，并允许压缩 */
  height: 72rpx; /* 高度：72rpx */
  font-size: 25rpx; /* 字号：25rpx */
}

.meal-suggestion {
  margin-top: 12rpx; /* 上外边距：12rpx */
  padding: 12rpx; /* 内边距：内容到边框之间的间距；此处按 四边 设置为 12rpx。 */
  border: 1rpx solid #8ae4af; /* 设置 border 为 1rpx solid #8ae4af；宽度、线型、颜色可一起写，solid 实线、dashed 虚线，none/0 取消边框，transparent 为透明颜色。 */
  background: #edfff4; /* 背景：#edfff4 */
  color: #0bc968; /* 文字颜色：#0bc968 */
  font-size: 22rpx; /* 字号：22rpx */
  text-align: center; /* 文字水平居中 */
}

.meal-footer {
  position: fixed; /* 固定定位，常用于底栏或弹窗 */
  z-index: 5; /* 层叠顺序，同一层叠上下文中比较：5 */
  right: 0; /* 设置定位元素的 right 偏移为 0；参照对象由 position 和祖先决定，负数可移出参照边界，auto 表示自动计算。 */
  bottom: 0; /* 设置定位元素的 bottom 偏移为 0；参照对象由 position 和祖先决定，负数可移出参照边界，auto 表示自动计算。 */
  left: 0; /* 设置定位元素的 left 偏移为 0；参照对象由 position 和祖先决定，负数可移出参照边界，auto 表示自动计算。 */
  padding: 12rpx 16rpx calc(12rpx + env(safe-area-inset-bottom)); /* 内边距：内容到边框之间的间距；此处按 上、左右、下 设置为 12rpx 16rpx calc(12rpx + env(safe-area-inset-bottom))。 calc() 用于计算长度，例如整体宽度减边距，或基础内边距加安全区。 env(safe-area-inset-*) 读取设备对应边的安全区，避免内容贴住底部手势条等区域。 */
  background: #fff; /* 背景：#fff */
}

.meal-footer button {
  box-sizing: border-box; /* 设置的宽高包含内边距和边框 */
  width: 100%; /* 宽度：100% */
  height: 82rpx; /* 高度：82rpx */
  margin: 0 auto; /* 外边距：元素外侧的间距；此处按 上下、左右 设置为 0 auto。 auto 为自动分配；常见的 0 auto 可让有确定宽度的块水平居中，也受布局环境影响。 */
  padding: 0; /* 内边距：内容到边框之间的间距；此处按 四边 设置为 0。 */
  background: #0bd565; /* 背景：#0bd565 */
  color: #fff; /* 文字颜色：#fff */
  font-size: 28rpx; /* 字号：28rpx */
  line-height: normal; /* 设置行盒高度；无单位值乘以字号，rpx 值是明确行高，normal 由字体决定；相同高度和行高常用于单行文字居中；本行值为 normal。 */
}

.meal-footer button::after, .picker-actions button::after,
.deadline-actions button::after {
  border: none; /* 设置 border 为 none；宽度、线型、颜色可一起写，solid 实线、dashed 虚线，none/0 取消边框，transparent 为透明颜色。 */
}

.meal-mask {
  position: fixed; /* 固定定位，常用于底栏或弹窗 */
  z-index: 20; /* 层叠顺序，同一层叠上下文中比较：20 */
  inset: 0; /* 上右下左都贴边，配合定位覆盖区域 */
  background: rgba(0,0,0,.5); /* 背景：rgba(0,0,0,.5) */
}

.meal-restaurant-picker, .meal-building-picker {
  position: fixed; /* 固定定位，常用于底栏或弹窗 */
  z-index: 21; /* 层叠顺序，同一层叠上下文中比较：21 */
  right: 0; /* 设置定位元素的 right 偏移为 0；参照对象由 position 和祖先决定，负数可移出参照边界，auto 表示自动计算。 */
  bottom: 0; /* 设置定位元素的 bottom 偏移为 0；参照对象由 position 和祖先决定，负数可移出参照边界，auto 表示自动计算。 */
  left: 0; /* 设置定位元素的 left 偏移为 0；参照对象由 position 和祖先决定，负数可移出参照边界，auto 表示自动计算。 */
  background: #fff; /* 背景：#fff */
}

.meal-restaurant-picker {
  top: 50%; /* 设置定位元素的 top 偏移为 50%；参照对象由 position 和祖先决定，负数可移出参照边界，auto 表示自动计算。 */
  bottom: auto; /* 设置定位元素的 bottom 偏移为 auto；参照对象由 position 和祖先决定，负数可移出参照边界，auto 表示自动计算。 */
  margin: 0 16rpx; /* 外边距：元素外侧的间距；此处按 上下、左右 设置为 0 16rpx。 */
  border-radius: 10rpx; /* 设置圆角为 10rpx；一个值应用四角，四个值依次为左上、右上、右下、左下；50% 在正方形上得到圆形。 */
  transform: translateY(-50%); /* 变换元素：translateY(-50%)；rotate 用 deg 表示旋转角度，translate 的百分比通常按自身尺寸计算；translateY(-50%) 向上移动自身高度的一半。 */
}

.picker-heading {
  padding: 22rpx; /* 内边距：内容到边框之间的间距；此处按 四边 设置为 22rpx。 */
  color: #222; /* 文字颜色：#222 */
  font-size: 27rpx; /* 字号：27rpx */
  font-weight: bold; /* 文字加粗 */
  text-align: center; /* 文字水平居中 */
}

.picker-heading text {
  float: right; /* 向右浮动；作为 Flex 子项时不控制排列 */
  font-size: 34rpx; /* 字号：34rpx */
}

.restaurant-columns {
  height: 360rpx; /* 高度：360rpx */
}

.meal-restaurant-picker .picker-heading {
  border-bottom: 1rpx solid #eee; /* 设置 border-bottom 为 1rpx solid #eee；宽度、线型、颜色可一起写，solid 实线、dashed 虚线，none/0 取消边框，transparent 为透明颜色。 */
  text-align: left; /* 文字左对齐 */
}

.restaurant-option {
  display: flex; /* 启用弹性布局，排列内部元素 */
  align-items: center; /* 子元素沿交叉轴居中 */
  justify-content: center; /* 子元素沿主轴居中 */
  height: 70rpx; /* 高度：70rpx */
  overflow: hidden; /* 裁掉超出区域的内容 */
  color: #444; /* 文字颜色：#444 */
  font-size: 23rpx; /* 字号：23rpx */
  text-align: center; /* 文字水平居中 */
}

.picker-actions {
  display: flex; /* 启用弹性布局，排列内部元素 */
  justify-content: center; /* 子元素沿主轴居中 */
  gap: 20rpx; /* 子元素之间的间隔：20rpx */
  padding: 16rpx; /* 内边距：内容到边框之间的间距；此处按 四边 设置为 16rpx。 */
}

.picker-actions button {
  width: 180rpx; /* 宽度：180rpx */
  margin: 0; /* 外边距：元素外侧的间距；此处按 四边 设置为 0。 */
  background: #eee; /* 背景：#eee */
  font-size: 25rpx; /* 字号：25rpx */
}

.picker-actions .primary {
  background: #0bd565; /* 背景：#0bd565 */
  color: #fff; /* 文字颜色：#fff */
}

.meal-building-picker {
  height: 75vh; /* 高度：75vh */
  border-radius: 18rpx 18rpx 0 0; /* 设置圆角为 18rpx 18rpx 0 0；一个值应用四角，四个值依次为左上、右上、右下、左下；50% 在正方形上得到圆形。 */
}

.building-search {
  display: flex; /* 启用弹性布局，排列内部元素 */
  align-items: center; /* 子元素沿交叉轴居中 */
  gap: 16rpx; /* 子元素之间的间隔：16rpx */
  box-sizing: border-box; /* 设置的宽高包含内边距和边框 */
  width: calc(100% - 32rpx); /* 宽度：calc(100% - 32rpx)，通过计算得到实际长度 */
  height: 70rpx; /* 高度：70rpx */
  margin: 0 16rpx; /* 外边距：元素外侧的间距；此处按 上下、左右 设置为 0 16rpx。 */
  padding: 0 20rpx; /* 内边距：内容到边框之间的间距；此处按 上下、左右 设置为 0 20rpx。 */
  border-radius: 8rpx; /* 设置圆角为 8rpx；一个值应用四角，四个值依次为左上、右上、右下、左下；50% 在正方形上得到圆形。 */
  background: #f5f5f5; /* 背景：#f5f5f5 */
  font-size: 24rpx; /* 字号：24rpx */
}

.building-search input {
  flex: 1; /* 按权重 1 分配剩余空间，并允许压缩 */
  min-width: 0; /* 允许子元素缩小，避免长内容撑宽布局 */
  height: 70rpx; /* 高度：70rpx */
}

.meal-building-picker {
  display: flex; /* 启用弹性布局，排列内部元素 */
  flex-direction: column; /* 主轴改为竖直方向，子元素上下排列 */
  overflow: hidden; /* 裁掉超出区域的内容 */
}

.building-list {
  flex: 1; /* 按权重 1 分配剩余空间，并允许压缩 */
  min-height: 0; /* 允许子元素缩小，避免内容撑高布局 */
  height: 0; /* 高度：0 */
  padding-bottom: env(safe-area-inset-bottom); /* 下内边距：env(safe-area-inset-bottom)，为设备安全区留空间 */
}

.building-list view {
  padding: 28rpx; /* 内边距：内容到边框之间的间距；此处按 四边 设置为 28rpx。 */
  color: #333; /* 文字颜色：#333 */
  font-size: 26rpx; /* 字号：26rpx */
}

.building-list .building-empty {
  color: #aaa; /* 文字颜色：#aaa */
  text-align: center; /* 文字水平居中 */
}

.building-list view text {
  float: right; /* 向右浮动；作为 Flex 子项时不控制排列 */
  color: #999; /* 文字颜色：#999 */
}

.building-steps {
  padding: 6rpx 22rpx 12rpx; /* 内边距：内容到边框之间的间距；此处按 上、左右、下 设置为 6rpx 22rpx 12rpx。 */
  border-bottom: 1rpx solid #eee; /* 设置 border-bottom 为 1rpx solid #eee；宽度、线型、颜色可一起写，solid 实线、dashed 虚线，none/0 取消边框，transparent 为透明颜色。 */
}

.building-step {
  display: flex; /* 启用弹性布局，排列内部元素 */
  align-items: center; /* 子元素沿交叉轴居中 */
  justify-content: space-between; /* 两端贴边，中间空隙均分 */
  min-height: 64rpx; /* 最小高度，内容多时可以增高：64rpx */
  color: #777; /* 文字颜色：#777 */
  font-size: 24rpx; /* 字号：24rpx */
}

.building-step .selected {
  color: #0bd565; /* 文字颜色：#0bd565 */
  font-weight: bold; /* 文字加粗 */
}

.building-step-left {
  display: flex; /* 启用弹性布局，排列内部元素 */
  align-items: center; /* 子元素沿交叉轴居中 */
  gap: 24rpx; /* 子元素之间的间隔：24rpx */
}

.building-dot {
  position: relative; /* 保留布局占位，作为绝对定位的参照 */
  width: 14rpx; /* 宽度：14rpx */
  height: 14rpx; /* 高度：14rpx */
  flex-shrink: 0; /* 空间不足时不压缩 */
  border-radius: 50%; /* 设置圆角为 50%；一个值应用四角，四个值依次为左上、右上、右下、左下；50% 在正方形上得到圆形。 */
  background: #0bd565; /* 背景：#0bd565 */
}

.building-dot.with-line::after {
  content: ''; /* 生成空伪元素，用于绘制装饰 */
  position: absolute; /* 脱离普通布局，相对定位祖先摆放 */
  top: 22rpx; /* 设置定位元素的 top 偏移为 22rpx；参照对象由 position 和祖先决定，负数可移出参照边界，auto 表示自动计算。 */
  left: 6rpx; /* 设置定位元素的 left 偏移为 6rpx；参照对象由 position 和祖先决定，负数可移出参照边界，auto 表示自动计算。 */
  width: 2rpx; /* 宽度：2rpx */
  height: 32rpx; /* 高度：32rpx */
  background: #b5e8ce; /* 背景：#b5e8ce */
}

.meal-deadline-picker {
  position: fixed; /* 固定定位，常用于底栏或弹窗 */
  z-index: 21; /* 层叠顺序，同一层叠上下文中比较：21 */
  top: 50%; /* 设置定位元素的 top 偏移为 50%；参照对象由 position 和祖先决定，负数可移出参照边界，auto 表示自动计算。 */
  right: 16rpx; /* 设置定位元素的 right 偏移为 16rpx；参照对象由 position 和祖先决定，负数可移出参照边界，auto 表示自动计算。 */
  left: 16rpx; /* 设置定位元素的 left 偏移为 16rpx；参照对象由 position 和祖先决定，负数可移出参照边界，auto 表示自动计算。 */
  transform: translateY(-50%); /* 变换元素：translateY(-50%)；rotate 用 deg 表示旋转角度，translate 的百分比通常按自身尺寸计算；translateY(-50%) 向上移动自身高度的一半。 */
  border-radius: 10rpx; /* 设置圆角为 10rpx；一个值应用四角，四个值依次为左上、右上、右下、左下；50% 在正方形上得到圆形。 */
  background: #fff; /* 背景：#fff */
}

.deadline-heading {
  display: flex; /* 启用弹性布局，排列内部元素 */
  justify-content: space-between; /* 两端贴边，中间空隙均分 */
  padding: 24rpx 28rpx; /* 内边距：内容到边框之间的间距；此处按 上下、左右 设置为 24rpx 28rpx。 */
  border-bottom: 1rpx solid #eee; /* 设置 border-bottom 为 1rpx solid #eee；宽度、线型、颜色可一起写，solid 实线、dashed 虚线，none/0 取消边框，transparent 为透明颜色。 */
  color: #222; /* 文字颜色：#222 */
  font-size: 29rpx; /* 字号：29rpx */
  font-weight: bold; /* 文字加粗 */
}

.deadline-custom-time {
  padding: 0 20rpx; /* 内边距：内容到边框之间的间距；此处按 上下、左右 设置为 0 20rpx。 */
}

.deadline-wheel {
  height: 360rpx; /* 高度：360rpx */
}

.deadline-wheel picker-view-column view {
  height: 70rpx; /* 高度：70rpx */
  display: flex; /* 启用弹性布局，排列内部元素 */
  align-items: center; /* 子元素沿交叉轴居中 */
  justify-content: center; /* 子元素沿主轴居中 */
  font-size: 26rpx; /* 字号：26rpx */
}

.deadline-actions {
  display: flex; /* 启用弹性布局，排列内部元素 */
  gap: 20rpx; /* 子元素之间的间隔：20rpx */
  padding: 16rpx 20rpx calc(16rpx + env(safe-area-inset-bottom)); /* 内边距：内容到边框之间的间距；此处按 上、左右、下 设置为 16rpx 20rpx calc(16rpx + env(safe-area-inset-bottom))。 calc() 用于计算长度，例如整体宽度减边距，或基础内边距加安全区。 env(safe-area-inset-*) 读取设备对应边的安全区，避免内容贴住底部手势条等区域。 */
}

.deadline-actions {
  justify-content: center; /* 子元素沿主轴居中 */
  padding: 24rpx; /* 内边距：内容到边框之间的间距；此处按 四边 设置为 24rpx。 */
}

.deadline-actions button {
  flex: none; /* 不伸长，也不压缩 */
  width: 180rpx; /* 宽度：180rpx */
  margin: 0; /* 外边距：元素外侧的间距；此处按 四边 设置为 0。 */
  height: 74rpx; /* 高度：74rpx */
  line-height: 74rpx; /* 设置行盒高度；无单位值乘以字号，rpx 值是明确行高，normal 由字体决定；相同高度和行高常用于单行文字居中；本行值为 74rpx。 */
  font-size: 26rpx; /* 字号：26rpx */
  background: #eee; /* 背景：#eee */
  color: #222; /* 文字颜色：#222 */
}

.deadline-actions .primary {
  background: #0bd565; /* 背景：#0bd565 */
  color: #fff; /* 文字颜色：#fff */
}
