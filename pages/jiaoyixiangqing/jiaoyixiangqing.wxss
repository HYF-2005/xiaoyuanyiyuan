/* 账单详情：展示选中账单的金额、时间和订单编号：本文件控制页面外观，不发请求、不改数据库。 */
page {
  background: #f5f5f5; /* 背景：#f5f5f5 */
}

.bill-page {
  padding: 20rpx; /* 内边距：内容到边框之间的间距；此处按 四边 设置为 20rpx。 */
}

.bill-banner {
  display: flex; /* 启用弹性布局，排列内部元素 */
  flex-direction: column; /* 主轴改为竖直方向，子元素上下排列 */
  align-items: center; /* 子元素沿交叉轴居中 */
  justify-content: center; /* 子元素沿主轴居中 */
  min-height: 370rpx; /* 最小高度，内容多时可以增高：370rpx */
  padding: 28rpx; /* 内边距：内容到边框之间的间距；此处按 四边 设置为 28rpx。 */
  box-sizing: border-box; /* 设置的宽高包含内边距和边框 */
  border-radius: 12rpx; /* 设置圆角为 12rpx；一个值应用四角，四个值依次为左上、右上、右下、左下；50% 在正方形上得到圆形。 */
  background: #0bd565; /* 背景：#0bd565 */
  color: #fff; /* 文字颜色：#fff */
}

.bill-icon {
  display: flex; /* 启用弹性布局，排列内部元素 */
  align-items: center; /* 子元素沿交叉轴居中 */
  justify-content: center; /* 子元素沿主轴居中 */
  width: 74rpx; /* 宽度：74rpx */
  height: 74rpx; /* 高度：74rpx */
  border: 2rpx solid #fff; /* 设置 border 为 2rpx solid #fff；宽度、线型、颜色可一起写，solid 实线、dashed 虚线，none/0 取消边框，transparent 为透明颜色。 */
  border-radius: 50%; /* 设置圆角为 50%；一个值应用四角，四个值依次为左上、右上、右下、左下；50% 在正方形上得到圆形。 */
  font-size: 42rpx; /* 字号：42rpx */
}

.bill-amount {
  margin-top: 32rpx; /* 上外边距：32rpx */
  font-size: 60rpx; /* 字号：60rpx */
  line-height: 1.2; /* 设置行盒高度；无单位值乘以字号，rpx 值是明确行高，normal 由字体决定；相同高度和行高常用于单行文字居中；本行值为 1.2。 */
  font-weight: bold; /* 文字加粗 */
}

.bill-title {
  margin-top: 28rpx; /* 上外边距：28rpx */
  font-size: 27rpx; /* 字号：27rpx */
  text-align: center; /* 文字水平居中 */
}

.bill-card {
  margin-top: 20rpx; /* 上外边距：20rpx */
  padding: 0 28rpx 22rpx; /* 内边距：内容到边框之间的间距；此处按 上、左右、下 设置为 0 28rpx 22rpx。 */
  border-radius: 12rpx; /* 设置圆角为 12rpx；一个值应用四角，四个值依次为左上、右上、右下、左下；50% 在正方形上得到圆形。 */
  background: #fff; /* 背景：#fff */
}

.bill-heading {
  padding: 34rpx 0 24rpx; /* 内边距：内容到边框之间的间距；此处按 上、左右、下 设置为 34rpx 0 24rpx。 */
  border-bottom: 1rpx solid #eee; /* 设置 border-bottom 为 1rpx solid #eee；宽度、线型、颜色可一起写，solid 实线、dashed 虚线，none/0 取消边框，transparent 为透明颜色。 */
  color: #222; /* 文字颜色：#222 */
  font-size: 30rpx; /* 字号：30rpx */
  font-weight: bold; /* 文字加粗 */
}

.bill-row {
  display: flex; /* 启用弹性布局，排列内部元素 */
  align-items: center; /* 子元素沿交叉轴居中 */
  justify-content: space-between; /* 两端贴边，中间空隙均分 */
  gap: 20rpx; /* 子元素之间的间隔：20rpx */
  min-height: 88rpx; /* 最小高度，内容多时可以增高：88rpx */
  border-bottom: 1rpx solid #f5f5f5; /* 设置 border-bottom 为 1rpx solid #f5f5f5；宽度、线型、颜色可一起写，solid 实线、dashed 虚线，none/0 取消边框，transparent 为透明颜色。 */
  color: #333; /* 文字颜色：#333 */
  font-size: 27rpx; /* 字号：27rpx */
}

.bill-row:last-child {
  border-bottom: 0; /* 设置 border-bottom 为 0；宽度、线型、颜色可一起写，solid 实线、dashed 虚线，none/0 取消边框，transparent 为透明颜色。 */
}

.bill-label {
  flex-shrink: 0; /* 空间不足时不压缩 */
  color: #777; /* 文字颜色：#777 */
}

.bill-row > text:last-child {
  text-align: right; /* 文字右对齐 */
}

.bill-order {
  display: flex; /* 启用弹性布局，排列内部元素 */
  align-items: center; /* 子元素沿交叉轴居中 */
  justify-content: flex-end; /* 子元素沿主轴靠终点 */
  gap: 12rpx; /* 子元素之间的间隔：12rpx */
  min-width: 0; /* 允许子元素缩小，避免长内容撑宽布局 */
}

.bill-number {
  overflow-wrap: anywhere; /* 控制长文字断行；break-word 在必要时拆开长词，anywhere 允许任意位置断行并影响最小内容宽度；本行值为 anywhere。 */
  text-align: right; /* 文字右对齐 */
  font-size: 26rpx; /* 字号：26rpx */
}

.copy-button {
  flex-shrink: 0; /* 空间不足时不压缩 */
  margin: 0; /* 外边距：元素外侧的间距；此处按 四边 设置为 0。 */
  padding: 0 13rpx; /* 内边距：内容到边框之间的间距；此处按 上下、左右 设置为 0 13rpx。 */
  height: 48rpx; /* 高度：48rpx */
  border: 1rpx solid #51c497; /* 设置 border 为 1rpx solid #51c497；宽度、线型、颜色可一起写，solid 实线、dashed 虚线，none/0 取消边框，transparent 为透明颜色。 */
  border-radius: 4rpx; /* 设置圆角为 4rpx；一个值应用四角，四个值依次为左上、右上、右下、左下；50% 在正方形上得到圆形。 */
  background: #fff; /* 背景：#fff */
  color: #40b980; /* 文字颜色：#40b980 */
  font-size: 22rpx; /* 字号：22rpx */
  line-height: 46rpx; /* 设置行盒高度；无单位值乘以字号，rpx 值是明确行高，normal 由字体决定；相同高度和行高常用于单行文字居中；本行值为 46rpx。 */
}

.copy-button::after {
  border: 0; /* 设置 border 为 0；宽度、线型、颜色可一起写，solid 实线、dashed 虚线，none/0 取消边框，transparent 为透明颜色。 */
}

.bill-success {
  color: #40b980; /* 文字颜色：#40b980 */
}

.bill-empty {
  padding: 80rpx 0; /* 内边距：内容到边框之间的间距；此处按 上下、左右 设置为 80rpx 0。 */
  color: #999; /* 文字颜色：#999 */
  text-align: center; /* 文字水平居中 */
}
