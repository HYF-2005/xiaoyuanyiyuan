/* 取件订单详情：按身份和状态显示接单、拍照、确认与取消操作：本文件控制页面外观，不发请求、不改数据库。 */
page {
  background: #f5f5f5; /* 背景：#f5f5f5 */
}

.detail-page {
  padding: 20rpx 0 170rpx; /* 内边距：内容到边框之间的间距；此处按 上、左右、下 设置为 20rpx 0 170rpx。 */
}

.progress-card {
  padding: 30rpx 22rpx 12rpx; /* 内边距：内容到边框之间的间距；此处按 上、左右、下 设置为 30rpx 22rpx 12rpx。 */
  background: #fff; /* 背景：#fff */
}

.progress-heading {
  display: flex; /* 启用弹性布局，排列内部元素 */
  align-items: center; /* 子元素沿交叉轴居中 */
  color: #222; /* 文字颜色：#222 */
  font-size: 32rpx; /* 字号：32rpx */
  font-weight: bold; /* 文字加粗 */
}

.progress-heading-icon {
  margin-right: 10rpx; /* 右外边距：10rpx */
  color: #0bd565; /* 文字颜色：#0bd565 */
  font-size: 30rpx; /* 字号：30rpx */
}

.order-number {
  margin-top: 18rpx; /* 上外边距：18rpx */
  padding: 14rpx; /* 内边距：内容到边框之间的间距；此处按 四边 设置为 14rpx。 */
  border-radius: 5rpx; /* 设置圆角为 5rpx；一个值应用四角，四个值依次为左上、右上、右下、左下；50% 在正方形上得到圆形。 */
  background: #f7f8f8; /* 背景：#f7f8f8 */
  color: #999; /* 文字颜色：#999 */
  font-size: 23rpx; /* 字号：23rpx */
  letter-spacing: 2rpx; /* 字符之间的额外间距：2rpx */
}

.timeline {
  margin-top: 20rpx; /* 上外边距：20rpx */
  padding-top: 36rpx; /* 上内边距：36rpx */
  border-top: 1rpx solid #eee; /* 设置 border-top 为 1rpx solid #eee；宽度、线型、颜色可一起写，solid 实线、dashed 虚线，none/0 取消边框，transparent 为透明颜色。 */
}

.timeline-step {
  position: relative; /* 保留布局占位，作为绝对定位的参照 */
  display: flex; /* 启用弹性布局，排列内部元素 */
  min-height: 138rpx; /* 最小高度，内容多时可以增高：138rpx */
  color: #aaa; /* 文字颜色：#aaa */
}

.timeline-step::before {
  content: ''; /* 生成空伪元素，用于绘制装饰 */
  position: absolute; /* 脱离普通布局，相对定位祖先摆放 */
  left: 20rpx; /* 设置定位元素的 left 偏移为 20rpx；参照对象由 position 和祖先决定，负数可移出参照边界，auto 表示自动计算。 */
  top: 25rpx; /* 设置定位元素的 top 偏移为 25rpx；参照对象由 position 和祖先决定，负数可移出参照边界，auto 表示自动计算。 */
  bottom: 0; /* 设置定位元素的 bottom 偏移为 0；参照对象由 position 和祖先决定，负数可移出参照边界，auto 表示自动计算。 */
  width: 2rpx; /* 宽度：2rpx */
  background: #e0e0e0; /* 背景：#e0e0e0 */
}

.timeline-step.last::before {
  display: none; /* 隐藏元素，并取消其占位 */
}

.timeline-step.current {
  min-height: 420rpx; /* 最小高度，内容多时可以增高：420rpx */
}

.timeline-dot {
  z-index: 1; /* 层叠顺序，同一层叠上下文中比较：1 */
  flex-shrink: 0; /* 空间不足时不压缩 */
  width: 15rpx; /* 宽度：15rpx */
  height: 15rpx; /* 高度：15rpx */
  margin: 9rpx 29rpx 0 13rpx; /* 外边距：元素外侧的间距；此处按 上、右、下、左 设置为 9rpx 29rpx 0 13rpx。 */
  border-radius: 50%; /* 设置圆角为 50%；一个值应用四角，四个值依次为左上、右上、右下、左下；50% 在正方形上得到圆形。 */
  background: #ddd; /* 背景：#ddd */
}

.current .timeline-dot, .cancelled .timeline-dot {
  background: #0bd565; /* 背景：#0bd565 */
}

.timeline-body {
  flex: 1; /* 按权重 1 分配剩余空间，并允许压缩 */
  min-width: 0; /* 允许子元素缩小，避免长内容撑宽布局 */
  padding-bottom: 26rpx; /* 下内边距：26rpx */
}

.step-title {
  font-size: 27rpx; /* 字号：27rpx */
}

.current .step-title, .cancelled .step-title {
  color: #0bd565; /* 文字颜色：#0bd565 */
  font-weight: bold; /* 文字加粗 */
}

.step-subtitle {
  margin-top: 12rpx; /* 上外边距：12rpx */
  font-size: 22rpx; /* 字号：22rpx */
}

.order-facts {
  margin-top: 20rpx; /* 上外边距：20rpx */
}

.fact-row {
  display: flex; /* 启用弹性布局，排列内部元素 */
  justify-content: space-between; /* 两端贴边，中间空隙均分 */
  gap: 16rpx; /* 子元素之间的间隔：16rpx */
  margin-bottom: 10rpx; /* 下外边距：10rpx */
  padding: 12rpx; /* 内边距：内容到边框之间的间距；此处按 四边 设置为 12rpx。 */
  border-radius: 4rpx; /* 设置圆角为 4rpx；一个值应用四角，四个值依次为左上、右上、右下、左下；50% 在正方形上得到圆形。 */
  background: #f7f8f8; /* 背景：#f7f8f8 */
  color: #555; /* 文字颜色：#555 */
  font-size: 25rpx; /* 字号：25rpx */
}

.fact-row text:last-child {
  color: #222; /* 文字颜色：#222 */
  text-align: right; /* 文字右对齐 */
}

.detail-footer {
  position: fixed; /* 固定定位，常用于底栏或弹窗 */
  right: 0; /* 设置定位元素的 right 偏移为 0；参照对象由 position 和祖先决定，负数可移出参照边界，auto 表示自动计算。 */
  bottom: 0; /* 设置定位元素的 bottom 偏移为 0；参照对象由 position 和祖先决定，负数可移出参照边界，auto 表示自动计算。 */
  left: 0; /* 设置定位元素的 left 偏移为 0；参照对象由 position 和祖先决定，负数可移出参照边界，auto 表示自动计算。 */
  padding: 18rpx 20rpx calc(18rpx + env(safe-area-inset-bottom)); /* 内边距：内容到边框之间的间距；此处按 上、左右、下 设置为 18rpx 20rpx calc(18rpx + env(safe-area-inset-bottom))。 calc() 用于计算长度，例如整体宽度减边距，或基础内边距加安全区。 env(safe-area-inset-*) 读取设备对应边的安全区，避免内容贴住底部手势条等区域。 */
  background: #fff; /* 背景：#fff */
}

.cancel-button {
  margin: 0; /* 外边距：元素外侧的间距；此处按 四边 设置为 0。 */
  background: #e6e6e6; /* 背景：#e6e6e6 */
  color: #111; /* 文字颜色：#111 */
  font-size: 27rpx; /* 字号：27rpx */
  font-weight: bold; /* 文字加粗 */
}

.cancel-button::after {
  border: none; /* 设置 border 为 none；宽度、线型、颜色可一起写，solid 实线、dashed 虚线，none/0 取消边框，transparent 为透明颜色。 */
}

.complete-button {
  background: #0bd565; /* 背景：#0bd565 */
  color: #fff; /* 文字颜色：#fff */
}

.complete-button::after {
  border: none; /* 设置 border 为 none；宽度、线型、颜色可一起写，solid 实线、dashed 虚线，none/0 取消边框，transparent 为透明颜色。 */
}

.proof-card {
  margin-top: 20rpx; /* 上外边距：20rpx */
  padding: 28rpx 22rpx; /* 内边距：内容到边框之间的间距；此处按 上下、左右 设置为 28rpx 22rpx。 */
  background: #fff; /* 背景：#fff */
}

.proof-title {
  font-size: 30rpx; /* 字号：30rpx */
  font-weight: bold; /* 文字加粗 */
}

.proof-image {
  display: block; /* 设置为块级显示 */
  width: 180rpx; /* 宽度：180rpx */
  height: 180rpx; /* 高度：180rpx */
  margin-top: 20rpx; /* 上外边距：20rpx */
  border-radius: 8rpx; /* 设置圆角为 8rpx；一个值应用四角，四个值依次为左上、右上、右下、左下；50% 在正方形上得到圆形。 */
}

.photo-mask {
  position: fixed; /* 固定定位，常用于底栏或弹窗 */
  z-index: 30; /* 层叠顺序，同一层叠上下文中比较：30 */
  inset: 0; /* 上右下左都贴边，配合定位覆盖区域 */
  display: flex; /* 启用弹性布局，排列内部元素 */
  align-items: center; /* 子元素沿交叉轴居中 */
  justify-content: center; /* 子元素沿主轴居中 */
  background: rgba(0, 0, 0, .55); /* 背景：rgba(0, 0, 0, .55) */
}

.photo-dialog {
  box-sizing: border-box; /* 设置的宽高包含内边距和边框 */
  width: 630rpx; /* 宽度：630rpx */
  padding: 24rpx; /* 内边距：内容到边框之间的间距；此处按 四边 设置为 24rpx。 */
  border-radius: 12rpx; /* 设置圆角为 12rpx；一个值应用四角，四个值依次为左上、右上、右下、左下；50% 在正方形上得到圆形。 */
  background: #fff; /* 背景：#fff */
}

.photo-title {
  padding: 10rpx 0 22rpx; /* 内边距：内容到边框之间的间距；此处按 上、左右、下 设置为 10rpx 0 22rpx。 */
  font-size: 30rpx; /* 字号：30rpx */
  font-weight: bold; /* 文字加粗 */
  text-align: center; /* 文字水平居中 */
}

.photo-preview {
  display: block; /* 设置为块级显示 */
  width: 100%; /* 宽度：100% */
  height: 480rpx; /* 高度：480rpx */
  background: #f5f5f5; /* 背景：#f5f5f5 */
}

.photo-tip {
  padding: 20rpx 0; /* 内边距：内容到边框之间的间距；此处按 上下、左右 设置为 20rpx 0。 */
  color: #777; /* 文字颜色：#777 */
  font-size: 23rpx; /* 字号：23rpx */
}

.photo-actions {
  display: flex; /* 启用弹性布局，排列内部元素 */
  gap: 15rpx; /* 子元素之间的间隔：15rpx */
}

.photo-actions button {
  flex: 1; /* 按权重 1 分配剩余空间，并允许压缩 */
  margin: 0; /* 外边距：元素外侧的间距；此处按 四边 设置为 0。 */
  font-size: 25rpx; /* 字号：25rpx */
}

.photo-actions button:first-child {
  background: #e6e6e6; /* 背景：#e6e6e6 */
  color: #222; /* 文字颜色：#222 */
}

.photo-actions button::after {
  border: none; /* 设置 border 为 none；宽度、线型、颜色可一起写，solid 实线、dashed 虚线，none/0 取消边框，transparent 为透明颜色。 */
}

.action-footer {
  display: flex; /* 启用弹性布局，排列内部元素 */
  gap: 16rpx; /* 子元素之间的间隔：16rpx */
}

.action-footer button {
  flex: 1; /* 按权重 1 分配剩余空间，并允许压缩 */
  margin: 0; /* 外边距：元素外侧的间距；此处按 四边 设置为 0。 */
  font-size: 25rpx; /* 字号：25rpx */
}

.secondary-button {
  background: #e6e6e6; /* 背景：#e6e6e6 */
  color: #222; /* 文字颜色：#222 */
}

.secondary-button::after {
  border: none; /* 设置 border 为 none；宽度、线型、颜色可一起写，solid 实线、dashed 虚线，none/0 取消边框，transparent 为透明颜色。 */
}

.action-footer .cancel-button {
  background: #d43d47; /* 背景：#d43d47 */
  color: #fff; /* 文字颜色：#fff */
}

.view-photo-button {
  margin: 18rpx 0 25rpx; /* 外边距：元素外侧的间距；此处按 上、左右、下 设置为 18rpx 0 25rpx。 */
  border: 1rpx solid #0bd565; /* 设置 border 为 1rpx solid #0bd565；宽度、线型、颜色可一起写，solid 实线、dashed 虚线，none/0 取消边框，transparent 为透明颜色。 */
  background: #fff; /* 背景：#fff */
  color: #0bd565; /* 文字颜色：#0bd565 */
  font-size: 26rpx; /* 字号：26rpx */
}

.view-photo-button::after {
  border: none; /* 设置 border 为 none；宽度、线型、颜色可一起写，solid 实线、dashed 虚线，none/0 取消边框，transparent 为透明颜色。 */
}

.confirm-message {
  padding: 32rpx 12rpx 48rpx; /* 内边距：内容到边框之间的间距；此处按 上、左右、下 设置为 32rpx 12rpx 48rpx。 */
  font-size: 26rpx; /* 字号：26rpx */
  text-align: center; /* 文字水平居中 */
}

.feedback-link {
  display: inline-flex;
  align-items: center;
  gap: 6rpx;
  margin-top: 18rpx;
  color: #0bd565;
  font-size: 24rpx;
  line-height: 1.5;
}

.feedback-link-arrow {
  font-size: 30rpx;
  line-height: 1;
}
