/* 账户设置：安全页面入口、协议弹窗与退出登录：本文件控制页面外观，不发请求、不改数据库。 */
page {
  background: #f5f5f5; /* 背景：#f5f5f5 */
}

.settings-heading {
  display: flex; /* 启用弹性布局，排列内部元素 */
  align-items: center; /* 子元素沿交叉轴居中 */
  padding: 24rpx 30rpx; /* 内边距：内容到边框之间的间距；此处按 上下、左右 设置为 24rpx 30rpx。 */
  color: #999; /* 文字颜色：#999 */
  font-size: 25rpx; /* 字号：25rpx */
}

.settings-heading-icon {
  width: 42rpx; /* 宽度：42rpx */
  height: 42rpx; /* 高度：42rpx */
  margin-right: 12rpx; /* 右外边距：12rpx */
}

.settings-group {
  background: #fff; /* 背景：#fff */
}

.settings-row {
  display: flex; /* 启用弹性布局，排列内部元素 */
  align-items: center; /* 子元素沿交叉轴居中 */
  height: 110rpx; /* 高度：110rpx */
  padding: 0 30rpx; /* 内边距：内容到边框之间的间距；此处按 上下、左右 设置为 0 30rpx。 */
}

.settings-row + .settings-row {
  border-top: 1rpx solid #eee; /* 设置 border-top 为 1rpx solid #eee；宽度、线型、颜色可一起写，solid 实线、dashed 虚线，none/0 取消边框，transparent 为透明颜色。 */
}

.settings-icon {
  width: 42rpx; /* 宽度：42rpx */
  height: 42rpx; /* 高度：42rpx */
  flex: none; /* 不伸长，也不压缩 */
  margin-right: 22rpx; /* 右外边距：22rpx */
}

.settings-label {
  flex: 1; /* 按权重 1 分配剩余空间，并允许压缩 */
  color: #333; /* 文字颜色：#333 */
  font-size: 28rpx; /* 字号：28rpx */
}

.settings-value {
  margin-right: 14rpx; /* 右外边距：14rpx */
  color: #999; /* 文字颜色：#999 */
  font-size: 25rpx; /* 字号：25rpx */
}

.settings-arrow {
  color: #ccc; /* 文字颜色：#ccc */
  font-size: 32rpx; /* 字号：32rpx */
}

.settings-other-heading {
  margin-top: 32rpx; /* 上外边距：32rpx */
}

.settings-logout {
  display: flex; /* 启用弹性布局，排列内部元素 */
  align-items: center; /* 子元素沿交叉轴居中 */
  justify-content: center; /* 子元素沿主轴居中 */
  width: 340rpx; /* 宽度：340rpx */
  height: 96rpx; /* 高度：96rpx */
  margin: 56rpx auto; /* 外边距：元素外侧的间距；此处按 上下、左右 设置为 56rpx auto。 auto 为自动分配；常见的 0 auto 可让有确定宽度的块水平居中，也受布局环境影响。 */
  padding: 0; /* 内边距：内容到边框之间的间距；此处按 四边 设置为 0。 */
  border: 1rpx solid #ff5964; /* 设置 border 为 1rpx solid #ff5964；宽度、线型、颜色可一起写，solid 实线、dashed 虚线，none/0 取消边框，transparent 为透明颜色。 */
  border-radius: 10rpx; /* 设置圆角为 10rpx；一个值应用四角，四个值依次为左上、右上、右下、左下；50% 在正方形上得到圆形。 */
  background: #fff; /* 背景：#fff */
  color: #ff4050; /* 文字颜色：#ff4050 */
  font-size: 28rpx; /* 字号：28rpx */
  font-weight: bold; /* 文字加粗 */
  line-height: normal; /* 设置行盒高度；无单位值乘以字号，rpx 值是明确行高，normal 由字体决定；相同高度和行高常用于单行文字居中；本行值为 normal。 */
}

.settings-logout::after {
  border: none; /* 设置 border 为 none；宽度、线型、颜色可一起写，solid 实线、dashed 虚线，none/0 取消边框，transparent 为透明颜色。 */
}

.about-overlay {
  position: fixed; /* 固定定位，常用于底栏或弹窗 */
  inset: 0; /* 上右下左都贴边，配合定位覆盖区域 */
  z-index: 100; /* 层叠顺序，同一层叠上下文中比较：100 */
  display: flex; /* 启用弹性布局，排列内部元素 */
  align-items: center; /* 子元素沿交叉轴居中 */
  justify-content: center; /* 子元素沿主轴居中 */
  background: rgba(0, 0, 0, 0.35); /* 背景：rgba(0, 0, 0, 0.35) */
}

.about-dialog {
  box-sizing: border-box; /* 设置的宽高包含内边距和边框 */
  width: 590rpx; /* 宽度：590rpx */
  padding: 54rpx 46rpx 48rpx; /* 内边距：内容到边框之间的间距；此处按 上、左右、下 设置为 54rpx 46rpx 48rpx。 */
  border-radius: 26rpx; /* 设置圆角为 26rpx；一个值应用四角，四个值依次为左上、右上、右下、左下；50% 在正方形上得到圆形。 */
  background: #fff; /* 背景：#fff */
  text-align: center; /* 文字水平居中 */
}

.about-title {
  color: #222; /* 文字颜色：#222 */
  font-size: 32rpx; /* 字号：32rpx */
}

.about-content {
  margin: 38rpx 0 48rpx; /* 外边距：元素外侧的间距；此处按 上、左右、下 设置为 38rpx 0 48rpx。 */
  color: #888; /* 文字颜色：#888 */
  font-size: 28rpx; /* 字号：28rpx */
  line-height: 1.5; /* 设置行盒高度；无单位值乘以字号，rpx 值是明确行高，normal 由字体决定；相同高度和行高常用于单行文字居中；本行值为 1.5。 */
}

.about-confirm {
  width: 340rpx; /* 宽度：340rpx */
  margin: 0 auto; /* 外边距：元素外侧的间距；此处按 上下、左右 设置为 0 auto。 auto 为自动分配；常见的 0 auto 可让有确定宽度的块水平居中，也受布局环境影响。 */
  background: #0bd565; /* 背景：#0bd565 */
  color: #fff; /* 文字颜色：#fff */
  font-size: 28rpx; /* 字号：28rpx */
}

.about-confirm::after {
  border: none; /* 设置 border 为 none；宽度、线型、颜色可一起写，solid 实线、dashed 虚线，none/0 取消边框，transparent 为透明颜色。 */
}

.policy-overlay {
  position: fixed; /* 固定定位，常用于底栏或弹窗 */
  inset: 0; /* 上右下左都贴边，配合定位覆盖区域 */
  z-index: 110; /* 层叠顺序，同一层叠上下文中比较：110 */
  display: flex; /* 启用弹性布局，排列内部元素 */
  align-items: center; /* 子元素沿交叉轴居中 */
  justify-content: center; /* 子元素沿主轴居中 */
  background: rgba(0,0,0,.4); /* 背景：rgba(0,0,0,.4) */
}

.policy-dialog {
  box-sizing: border-box; /* 设置的宽高包含内边距和边框 */
  width: 650rpx; /* 宽度：650rpx */
  max-height: 78vh; /* 最大高度：78vh */
  padding: 28rpx 30rpx; /* 内边距：内容到边框之间的间距；此处按 上下、左右 设置为 28rpx 30rpx。 */
  border-radius: 18rpx; /* 设置圆角为 18rpx；一个值应用四角，四个值依次为左上、右上、右下、左下；50% 在正方形上得到圆形。 */
  background: #fff; /* 背景：#fff */
}

.policy-title {
  position: relative; /* 保留布局占位，作为绝对定位的参照 */
  padding-bottom: 24rpx; /* 下内边距：24rpx */
  border-bottom: 1rpx solid #eee; /* 设置 border-bottom 为 1rpx solid #eee；宽度、线型、颜色可一起写，solid 实线、dashed 虚线，none/0 取消边框，transparent 为透明颜色。 */
  color: #222; /* 文字颜色：#222 */
  text-align: center; /* 文字水平居中 */
  font-size: 31rpx; /* 字号：31rpx */
  font-weight: bold; /* 文字加粗 */
}

.policy-title text {
  position: absolute; /* 脱离普通布局，相对定位祖先摆放 */
  right: 0; /* 设置定位元素的 right 偏移为 0；参照对象由 position 和祖先决定，负数可移出参照边界，auto 表示自动计算。 */
  top: -8rpx; /* 设置定位元素的 top 偏移为 -8rpx；参照对象由 position 和祖先决定，负数可移出参照边界，auto 表示自动计算。 */
  color: #777; /* 文字颜色：#777 */
  font-size: 40rpx; /* 字号：40rpx */
  font-weight: normal; /* 使用普通字重 */
}

.policy-scroll {
  height: 52vh; /* 高度：52vh */
  padding-top: 24rpx; /* 上内边距：24rpx */
  box-sizing: border-box; /* 设置的宽高包含内边距和边框 */
}

.policy-paragraph {
  margin-bottom: 24rpx; /* 下外边距：24rpx */
  color: #666; /* 文字颜色：#666 */
  font-size: 26rpx; /* 字号：26rpx */
  line-height: 1.7; /* 设置行盒高度；无单位值乘以字号，rpx 值是明确行高，normal 由字体决定；相同高度和行高常用于单行文字居中；本行值为 1.7。 */
}

.policy-confirm {
  height: 76rpx; /* 高度：76rpx */
  margin-top: 20rpx; /* 上外边距：20rpx */
  background: #0bd565; /* 背景：#0bd565 */
  color: #fff; /* 文字颜色：#fff */
  font-size: 27rpx; /* 字号：27rpx */
  line-height: 76rpx; /* 设置行盒高度；无单位值乘以字号，rpx 值是明确行高，normal 由字体决定；相同高度和行高常用于单行文字居中；本行值为 76rpx。 */
}

.policy-confirm::after {
  border: none; /* 设置 border 为 none；宽度、线型、颜色可一起写，solid 实线、dashed 虚线，none/0 取消边框，transparent 为透明颜色。 */
}
