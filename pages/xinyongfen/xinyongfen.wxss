/* 信用分：展示后端依据订单记录计算的分数与变动原因：本文件控制页面外观，不发请求、不改数据库。 */
page {
  background: #f5f5f5; /* 背景：#f5f5f5 */
}

.credit-summary {
  height: 400rpx; /* 高度：400rpx */
  display: flex; /* 启用弹性布局，排列内部元素 */
  flex-direction: column; /* 主轴改为竖直方向，子元素上下排列 */
  align-items: center; /* 子元素沿交叉轴居中 */
  justify-content: center; /* 子元素沿主轴居中 */
  background: #0bd565; /* 背景：#0bd565 */
  color: #fff; /* 文字颜色：#fff */
}

.credit-label {
  font-size: 28rpx; /* 字号：28rpx */
}

.credit-score {
  margin: 24rpx 0; /* 外边距：元素外侧的间距；此处按 上下、左右 设置为 24rpx 0。 */
  font-size: 128rpx; /* 字号：128rpx */
  line-height: 1; /* 设置行盒高度；无单位值乘以字号，rpx 值是明确行高，normal 由字体决定；相同高度和行高常用于单行文字居中；本行值为 1。 */
  font-weight: bold; /* 文字加粗 */
}

.credit-total {
  font-size: 24rpx; /* 字号：24rpx */
}

.credit-records {
  padding: 24rpx 16rpx; /* 内边距：内容到边框之间的间距；此处按 上下、左右 设置为 24rpx 16rpx。 */
}

.credit-records-title {
  margin-bottom: 24rpx; /* 下外边距：24rpx */
  color: #666; /* 文字颜色：#666 */
  font-size: 26rpx; /* 字号：26rpx */
}

.credit-record-card {
  display: flex; /* 启用弹性布局，排列内部元素 */
  align-items: center; /* 子元素沿交叉轴居中 */
  min-height: 120rpx; /* 最小高度，内容多时可以增高：120rpx */
  padding: 16rpx 28rpx; /* 内边距：内容到边框之间的间距；此处按 上下、左右 设置为 16rpx 28rpx。 */
  border-radius: 12rpx; /* 设置圆角为 12rpx；一个值应用四角，四个值依次为左上、右上、右下、左下；50% 在正方形上得到圆形。 */
  background: #fff; /* 背景：#fff */
}

.credit-record-icon {
  display: flex; /* 启用弹性布局，排列内部元素 */
  align-items: center; /* 子元素沿交叉轴居中 */
  justify-content: center; /* 子元素沿主轴居中 */
  width: 54rpx; /* 宽度：54rpx */
  height: 54rpx; /* 高度：54rpx */
  margin-right: 24rpx; /* 右外边距：24rpx */
  border-radius: 50%; /* 设置圆角为 50%；一个值应用四角，四个值依次为左上、右上、右下、左下；50% 在正方形上得到圆形。 */
  background: #e7fbf0; /* 背景：#e7fbf0 */
  color: #0bd565; /* 文字颜色：#0bd565 */
  font-size: 38rpx; /* 字号：38rpx */
}

.credit-record-info {
  flex: 1; /* 按权重 1 分配剩余空间，并允许压缩 */
  min-width: 0; /* 允许子元素缩小，避免长内容撑宽布局 */
}

.credit-record-reason {
  color: #333; /* 文字颜色：#333 */
  font-size: 26rpx; /* 字号：26rpx */
}

.credit-record-time {
  margin-top: 12rpx; /* 上外边距：12rpx */
  color: #999; /* 文字颜色：#999 */
  font-size: 22rpx; /* 字号：22rpx */
}

.credit-record-change {
  margin-left: 16rpx; /* 左外边距：16rpx */
  color: #0bd565; /* 文字颜色：#0bd565 */
  font-size: 30rpx; /* 字号：30rpx */
  font-weight: bold; /* 文字加粗 */
}

.credit-record-end {
  margin-top: 50rpx; /* 上外边距：50rpx */
  color: #aaa; /* 文字颜色：#aaa */
  font-size: 24rpx; /* 字号：24rpx */
  text-align: center; /* 文字水平居中 */
}

.credit-record-card + .credit-record-card {
  margin-top: 16rpx; /* 上外边距：16rpx */
}

.credit-record-icon.negative {
  background: #fff0f0; /* 背景：#fff0f0 */
  color: #d43d47; /* 文字颜色：#d43d47 */
}

.credit-record-change.negative {
  color: #d43d47; /* 文字颜色：#d43d47 */
}
